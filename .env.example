# ============================================================
# IFRS17 Docker 部署环境变量模板
# 用法：复制为 .env 后填写真实值
#   cp .env.example .env
# ============================================================

# ---- Django / 安全 ----
# 服务器访问地址（逗号分隔，对应 settings_prod 的 IFRS17_ALLOWED_HOSTS）
# 收紧到具体 IP/域名，替代原生产 '*'（修复测试报告 D-012）
IFRS17_ALLOWED_HOSTS=121.41.98.55,localhost,127.0.0.1

# CSRF 信任源（对应 IFRS17_CSRF_TRUSTED_ORIGINS），生产请收紧到具体域名/IP
IFRS17_CSRF_TRUSTED_ORIGINS=http://121.41.98.55

# Django SECRET_KEY（必填，生产请用强随机值生成：
#   python -c "import secrets; print(secrets.token_urlsafe(50))"）
IFRS17_SECRET_KEY=change-me-to-a-strong-random-secret

# ---- 数据库 ----
# 应用连接参数（与现有生产库一致；容器 db 服务据此创建库与用户）
IFRS17_DB_NAME=ifrs17
IFRS17_DB_USER=ifrs17
IFRS17_DB_PASSWORD=lyikPPkMYhr5frt0PRyS

# MySQL 容器 root 口令（仅容器内部使用，请设为强随机值）
MYSQL_ROOT_PASSWORD=change-me-root-password
