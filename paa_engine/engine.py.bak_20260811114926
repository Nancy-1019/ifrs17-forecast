# ============================================================
# 计算看门狗（防止单次计算内存/超时失控把 gunicorn 进程拖垮）
# ============================================================

class CalcAbortedError(Exception):
    """计算被看门狗主动中止（内存超限 / 超时）。

    该异常会被 worker 的 try/except 捕获并优雅上报为 error，
    绝不会触发 OS 的 OOM-killer 杀死进程（这是之前网页计算把整台服务器
    拖垮、连 SSH 都无响应的根因对应的保护机制）。
    """
    pass


def _current_rss_mb() -> float:
    """返回当前进程常驻内存（MB）。Linux 读 /proc/self/status，其余平台回退到 resource。"""
    try:
        with open('/proc/self/status', 'r', encoding='utf-8', errors='ignore') as f:
            for line in f:
                if line.startswith('VmRSS:'):
                    # VmRSS 单位为 kB
                    return float(line.split()[1]) / 1024.0
    except Exception:
        pass
    try:
        import resource
        # Linux 上 ru_maxrss 单位为 kB
        return float(resource.getrusage(resource.RUSAGE_SELF).ru_maxrss) / 1024.0
    except Exception:
        return 0.0


class _CalcWatchdog:
    """在重计算循环里周期性调用 tick()：

       - 每 tick_every 次把 message 透传给 on_tick（前端进度心跳可见）
       - 每 tick_every 次检查内存占用与累计耗时，超限抛 CalcAbortedError
    """

    def __init__(self, mem_limit_mb: float = 1100.0, time_limit_s: float = 600.0,
                 tick_every: int = 400, on_tick=None, scenario: str = ''):
        self.mem_limit_mb = float(mem_limit_mb)
        self.time_limit_s = float(time_limit_s)
        self.tick_every = max(1, int(tick_every))
        self.on_tick = on_tick
        self.scenario = scenario
        self._start = time.time()
        self._iter = 0

    def tick(self, message: str = None):
        self._iter += 1
        if self._iter % self.tick_every == 0:
            if message and self.on_tick is not None:
                try:
                    self.on_tick(message)
                except Exception:
                    pass
            self._check()

    def _check(self):
        el = time.time() - self._start
        if el > self.time_limit_s:
            raise CalcAbortedError(
                f'计算超时自动中止：已运行 {int(el)} 秒（上限 {int(self.time_limit_s)} 秒）。'
                f'请减少预测期数后重试，或联系管理员扩容。')
        rss = _current_rss_mb()
        if rss and rss > self.mem_limit_mb:
            raise CalcAbortedError(
                f'计算内存超限自动中止：当前占用 {int(rss)} MB（上限 {int(self.mem_limit_mb)} MB）。'
                f'服务器内存不足，已安全中止以保护网站服务（不会拖垮系统）。')


