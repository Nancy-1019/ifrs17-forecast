        return rows

    def _build_mtd_balance_sheet(self, combined_rows: list, forecast_periods: int,
                                  num_periods: int) -> list:
        """Build MTD balance sheet rows from combined summary."""
        # Aggregate liability columns by period and business type
        period_liabilities = defaultdict(lambda: {'直保或分入': 0.0, '分出': 0.0})

        for row in combined_rows:
            period = row.get('预测间隔', 1)
            biz_type = str(row.get('业务类型', ''))
            if biz_type == '直保或分入':
                cols = _PAA_DIRECT_LIABILITY_COLS
            else:
                cols = _PAA_CEDING_LIABILITY_COLS
            for col in cols:
                val = _to_float(row.get(col, 0))
                if biz_type in period_liabilities[period]:
                    period_liabilities[period][biz_type] += val

        rows = []
        for label, indent, is_total, ftype in BALANCE_SHEET_ITEMS:
            row = {'item': label, 'indent': indent, 'is_total': is_total, 'values': []}

            for p in range(num_periods):
                if p == 0:
                    row['values'].append(0.0)
                    continue

                pl = period_liabilities.get(p, {'直保或分入': 0, '分出': 0})
                val = 0.0

                if ftype == 'paa_insurance_liability':
                    val = pl.get('直保或分入', 0)
                elif ftype == 'paa_reins_asset':
                    # -SUMIFS for 分出 → negate
                    val = -pl.get('分出', 0)
                elif ftype == 'total_assets':
                    pass  # Will be calculated
                elif ftype == 'total_liabilities':
                    pass
                elif ftype == 'total_eq_liab':
                    pass
                # 'header', 'zero' → 0

                row['values'].append(round(val, 2))

            rows.append(row)

        # Calculate totals
        for p in range(num_periods):
            if p == 0:
                continue
            reins_asset = 0.0
            ins_liability = 0.0
            for r in rows:
                if r['item'] == '分出再保险合同资产':
                    reins_asset = r['values'][p]
                elif r['item'] == '保险合同负债':
                    ins_liability = r['values'][p]
            for r in rows:
                if r['item'] == '资产总计':
                    r['values'][p] = round(reins_asset, 2)
                elif r['item'] == '负债合计':
                    r['values'][p] = round(ins_liability, 2)
                elif r['item'] == '负债及所有者权益总计':
                    r['values'][p] = round(ins_liability + reins_asset, 2)

        return rows

    def _build_ytd_income_statement(self, mtd_rows: list, dates: list) -> list:
        """Build YTD income statement from MTD with January reset.

        YTD formula: IF(MONTH(date)=1, 0, prev_YTD) + MTD
        For derived items (totals, tax, etc.), recalculate from YTD components.
        """
        num_periods = len(dates)
        # Parse dates to get month numbers
        months = []
        for d in dates:
            if isinstance(d, str):
                try:
                    parts = d.split('-')
                    months.append(int(parts[1]))
                except (IndexError, ValueError):
                    months.append(1)
            elif hasattr(d, 'month'):
                months.append(d.month)
            else:
                months.append(1)

        # Build YTD for direct PAA items (cumulative with January reset)
        ytd_rows = []
        direct_types = {
            'paa_revenue', 'paa_service_expense', 'paa_ceding_expense',
            'paa_recover', 'paa_financial_loss', 'paa_reins_financial', 'oci',
            'paa_admin_expense', 'paa_tax',
            # Manual input items
            'interest_income', 'investment_income', 'other_income',
            'fair_value_income', 'fx_income', 'other_business_income',
            'asset_disposal_income',
            'premium_reserve', 'interest_expense', 'commission_expense',
            'credit_impairment', 'other_asset_impairment', 'other_business_cost',
            'non_operating_income', 'non_operating_expense',
        }

        for mtd_row in mtd_rows:
            ytd_row = {
                'item': mtd_row['item'],
                'indent': mtd_row['indent'],
                'is_total': mtd_row['is_total'],
                'values': [],
            }
            ftype = None
            for label, indent, is_total, ft in INCOME_STATEMENT_ITEMS:
                if label == mtd_row['item']:
                    ftype = ft
                    break

            if ftype in direct_types or ftype == 'zero':
                # YTD = IF(month=1, 0, prev_ytd) + MTD
                # 第 0 期（评估日）的 YTD 应等于当期 MTD（期初实际数）
                for p in range(num_periods):
                    if p == 0:
                        ytd_row['values'].append(round(mtd_row['values'][p], 2))
                    elif months[p] == 1:
                        ytd_row['values'].append(round(mtd_row['values'][p], 2))
                    else:
                        prev_ytd = ytd_row['values'][p - 1] if p > 0 else 0
                        ytd_row['values'].append(round(prev_ytd + mtd_row['values'][p], 2))
            else:
                # Totals and derived items - will be calculated in post-process
                ytd_row['values'] = [0.0] * num_periods

            ytd_rows.append(ytd_row)

        # Post-process: calculate YTD totals and derived items
        self._calc_income_statement_totals(ytd_rows, num_periods, is_ytd=True)

        # Calculate YTD income tax: YTD = prev_YTD_tax + (current_profit - prev_profit) * 0.25
        for r in ytd_rows:
            if r['item'] == '减：所得税费用':
                for p in range(1, num_periods):
                    profit_row = next((rr for rr in ytd_rows if rr['item'] == '四、利润总额（亏损总额以"-"号填列）'), None)
                    if profit_row and p > 0:
                        if months[p] == 1:
                            prev_tax = 0
                        else:
                            prev_tax = r['values'][p - 1]
                        curr_profit = profit_row['values'][p]
                        prev_profit = profit_row['values'][p - 1] if p > 0 else 0
                        r['values'][p] = round(prev_tax + (curr_profit - prev_profit) * 0.25, 2)
                break

        # Recalculate net profit and comprehensive income for YTD
        for r in ytd_rows:
            if r['item'] == '五、净利润（净亏损以"-"号填列）':
                profit_row = next((rr for rr in ytd_rows if rr['item'] == '四、利润总额（亏损总额以"-"号填列）'), None)
                tax_row = next((rr for rr in ytd_rows if rr['item'] == '减：所得税费用'), None)
                for p in range(num_periods):
                    r['values'][p] = round(
                        (profit_row['values'][p] if profit_row else 0) -
                        (tax_row['values'][p] if tax_row else 0), 2)
            elif r['item'] == '七、综合收益总额':
                net_row = next((rr for rr in ytd_rows if rr['item'] == '五、净利润（净亏损以"-"号填列）'), None)
                oci_row = next((rr for rr in ytd_rows if rr['item'] == '六、其他综合收益的税后净额'), None)
                for p in range(num_periods):
                    r['values'][p] = round(
                        (net_row['values'][p] if net_row else 0) +
                        (oci_row['values'][p] if oci_row else 0), 2)

        return ytd_rows

    def _calc_income_statement_totals(self, rows: list, num_periods: int, is_ytd: bool):
        """Calculate total and derived rows in income statement (in-place).

        period 0（评估时点）的总项已从"财务报表实际数"工作表填入，此处只计算承保利润
        （因为实际数据中没有承保利润行）。
        """
        # Build item lookup
        item_map = {r['item']: r for r in rows}

        for p in range(num_periods):
            def _v(item_name: str) -> float:
                return item_map.get(item_name, {}).get('values', [0] * num_periods)[p] if item_name in item_map else 0

            # period 0 总项保留实际数据，仅计算承保利润
            if p == 0:
                revenue = _v('保险服务收入')
                service_expense = _v('保险服务费用')
                ceding_expense = _v('分出保费的分摊')
                recover = _v('减：摊回保险服务费用')
                financial_loss = _v('承保财务损失')
                reins_financial = _v('减：分出再保险财务收益')
                premium_reserve = _v('提取保费准备金')
                if '承保利润' in item_map:
                    uw_profit = (
                        revenue - service_expense - ceding_expense + recover -
                        financial_loss + reins_financial - premium_reserve
                    )
                    item_map['承保利润']['values'][p] = round(uw_profit, 2)
                continue

            # Revenue items (already displayed as positive in report)
            revenue = _v('保险服务收入')
            interest_income = _v('利息收入')
            investment_income = _v('投资收益（损失以"-"号填列）')
            other_income = _v('其他收益（损失以"-"号填列）')
            fair_value_income = _v('公允价值变动收益（损失以"-"号填列）')
            fx_income = _v('汇兑收益（损失以"-"号填列）')
            other_business_income = _v('其他业务收入')
            asset_disposal_income = _v('资产处置收益（损失以"-"号填列）')

            # Expense items (already displayed as positive in report)
            service_expense = _v('保险服务费用')
            ceding_expense = _v('分出保费的分摊')
            recover = _v('减：摊回保险服务费用')
            financial_loss = _v('承保财务损失')
            reins_financial = _v('减：分出再保险财务收益')
            premium_reserve = _v('提取保费准备金')
            interest_expense = _v('利息支出')
            tax_surcharge = _v('税金及附加')
            commission_expense = _v('手续费及佣金支出')
            admin_expense = _v('业务及管理费')
            credit_impairment = _v('信用减值损失')
            other_asset_impairment = _v('其他资产减值损失')
            other_business_cost = _v('其他业务成本')

            # Non-operating items
            non_operating_income = _v('加：营业外收入')
            non_operating_expense = _v('减：营业外支出')

            # 一、营业总收入（period 0 取自实际数据，不重新计算）
            total_revenue = (
                revenue + interest_income + investment_income + other_income +
                fair_value_income + fx_income + other_business_income + asset_disposal_income
            )
            if '一、营业总收入' in item_map and p > 0:
                item_map['一、营业总收入']['values'][p] = round(total_revenue, 2)

            # 二、营业总支出 = SUM(expenses) - recover - reins_financial（period 0 取自实际数据）
            total_expense = (
                service_expense + ceding_expense + financial_loss + premium_reserve +
                interest_expense + tax_surcharge + commission_expense + admin_expense +
                credit_impairment + other_asset_impairment + other_business_cost -
                recover - reins_financial
            )
            if '二、营业总支出' in item_map and p > 0:
                item_map['二、营业总支出']['values'][p] = round(total_expense, 2)

            # 三、营业利润 = 营业总收入 - 营业总支出（period 0 取自实际数据）
            operating_profit = total_revenue - total_expense
            if '三、营业利润（亏损以"-"号填列）' in item_map and p > 0:
                item_map['三、营业利润（亏损以"-"号填列）']['values'][p] = round(operating_profit, 2)

            # 四、利润总额 = 营业利润 + 营业外收入 - 营业外支出（period 0 取自实际数据）
            total_profit = operating_profit + non_operating_income - non_operating_expense
            if '四、利润总额（亏损总额以"-"号填列）' in item_map and p > 0:
                item_map['四、利润总额（亏损总额以"-"号填列）']['values'][p] = round(total_profit, 2)

            # 减：所得税费用 = 利润总额 × 25%（period 0 取自实际数据，不重新计算）
            if '减：所得税费用' in item_map and p > 0:
                item_map['减：所得税费用']['values'][p] = round(total_profit * 0.25, 2)

            # 五、净利润 = 利润总额 - 所得税费用
            income_tax = _v('减：所得税费用')
            net_profit = total_profit - income_tax
            if '五、净利润（净亏损以"-"号填列）' in item_map:
                item_map['五、净利润（净亏损以"-"号填列）']['values'][p] = round(net_profit, 2)

            # 六、其他综合收益的税后净额 = OCI (already set from paa_mtd)
            oci_val = _v('六、其他综合收益的税后净额')

            # 七、综合收益总额 = 净利润 + OCI
            if '七、综合收益总额' in item_map:
                item_map['七、综合收益总额']['values'][p] = round(net_profit + oci_val, 2)

            # 承保利润 = 保险服务收入 - 保险服务费用 - 分出保费的分摊
            #            + 摊回保险服务费用 - 承保财务损失 + 分出再保险财务收益 - 提取保费准备金
            if '承保利润' in item_map:
                uw_profit = (
                    revenue - service_expense - ceding_expense + recover -
                    financial_loss + reins_financial - premium_reserve
                )
                item_map['承保利润']['values'][p] = round(uw_profit, 2)
