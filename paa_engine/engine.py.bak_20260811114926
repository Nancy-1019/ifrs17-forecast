def _to_float(v) -> float:
    """Safely convert value to float."""
    if v is None or v == '':
        return 0.0
    try:
        return float(v)
    except (ValueError, TypeError):
        return 0.0


def _norm_key(v) -> str:
    """Normalize a sheet key value to its canonical string.

    Mirrors the VBA/oracle convention: Excel date-typed 险类 codes
    (e.g. 交强险 stored as the date 1900-02-01) are converted to their
    serial string ('33' — note Excel's 1900 leap-year bug), so a lookup
    by 险类 code matches. Plain codes / strings pass through unchanged.
    """
    if isinstance(v, datetime.datetime):
        return str(v.toordinal() - datetime.date(1899, 12, 30).toordinal())
    if isinstance(v, datetime.date):
        return str(v.toordinal() - datetime.date(1899, 12, 30).toordinal())
    if isinstance(v, str):
        s = v.strip()
        head = s.split(' ')[0].split('T')[0]
        try:
            dt = datetime.datetime.strptime(head, '%Y-%m-%d')
            return str(dt.toordinal() - datetime.date(1899, 12, 30).toordinal())
        except Exception:
            return s
    return str(v)


