    def _get_pattern(self, sheet_name: str, key, alt_key=None) -> dict:
        """Get monthly pattern (60 values) from a pattern sheet.

        Returns {month_num: ratio}
        """
        cache_key = f'pattern_{sheet_name}_{key}'
        if cache_key in self._cache:
            return self._cache[cache_key]

        sheet = self._get_sheet(sheet_name)
        headers = sheet['headers']
        rows = sheet['rows']

        # Find key column (usually the last text column before numeric columns)
        key_col = -1
        for i, h in enumerate(headers):
            if h and not isinstance(h, (int, float)):
                try:
                    int(float(h))
                    break  # Found first numeric column
                except (ValueError, TypeError):
                    key_col = i

        if key_col < 0:
            key_col = 0

        # Build pattern for this key
        pattern = {}
        for row in rows:
            if key_col < len(row) and row[key_col] is not None:
                row_key = str(row[key_col])
                if row_key == str(key) or (alt_key and row_key == str(alt_key)):
                    # Read 60 numeric values
                    for i in range(key_col + 1, min(key_col + 61, len(headers))):
                        h = headers[i]
                        try:
                            month_num = int(float(h))
                            if i < len(row):
                                pattern[month_num] = _to_float(row[i])
                        except (ValueError, TypeError):
                            pass
                    break

        if not pattern and alt_key:
            # Try alt_key
            for row in rows:
                if key_col < len(row) and row[key_col] is not None:
                    if str(row[key_col]) == str(alt_key):
                        for i in range(key_col + 1, min(key_col + 61, len(headers))):
                            h = headers[i]
                            try:
                                month_num = int(float(h))
                                if i < len(row):
                                    pattern[month_num] = _to_float(row[i])
                            except (ValueError, TypeError):
                                pass
                        break

        self._cache[cache_key] = pattern
        return pattern

    def _get_pattern_existing(self, sheet_name: str, group_id: str, act_class: str) -> dict:
        """Get pattern for existing business.

        Existing business pattern sheets have multiple text columns (预测组, 精算险类, 业务类型).
        The auto-detected key column may not be the right one, so we search all text columns.
        """
        cache_key = f'pattern_existing_{sheet_name}_{group_id}'
        if cache_key in self._cache:
            return self._cache[cache_key]

        sheet = self._get_sheet(sheet_name)
        headers = sheet['headers']
        rows = sheet['rows']

        # Find all text columns (before first numeric column)
        first_numeric = len(headers)
        for i, h in enumerate(headers):
            if h:
                try:
                    int(float(h))
                    first_numeric = i
                    break
                except (ValueError, TypeError):
                    pass

        text_cols = [i for i in range(first_numeric) if headers[i]]

        # Strip &0 suffix for matching
        group_id_clean = group_id.replace('&0', '')

        # Search all text columns for a match
        pattern = {}
        for row in rows:
            matched = False
            for col in text_cols:
                if col < len(row) and row[col] is not None:
                    row_val = str(row[col])
                    if row_val == group_id or row_val == group_id_clean or row_val == str(act_class):
                        matched = True
                        break
            if matched:
                # Read 60 numeric values
                for i in range(first_numeric, min(first_numeric + 61, len(headers))):
                    h = headers[i]
                    try:
                        month_num = int(float(h))
                        if i < len(row):
                            pattern[month_num] = _to_float(row[i])
                    except (ValueError, TypeError):
                        pass
                break

        self._cache[cache_key] = pattern
        return pattern

    def _lookup_loss_ratio(self, act_class: str, pred_group: str, month: int, scenario_params: dict) -> float:
        """Look up loss ratio for a contract group at a given month."""
        sheet = self._get_sheet('预期赔付率')
        headers = sheet['headers']
        rows = sheet['rows']

        # Find key column (精算险类 or 预测组)
        key_col = -1
        for i, h in enumerate(headers):
            if h and ('精算险类' in str(h) or '预测组' in str(h)):
                key_col = i
                break

        if key_col < 0:
            key_col = 2  # Default

        # Find month column
        month_col = _match_month(headers, month)
        if month_col < 0:
            return 0.0

        for row in rows:
            if key_col < len(row) and row[key_col] is not None:
                if str(row[key_col]) == act_class or str(row[key_col]) == pred_group:
                    lr = _to_float(row[month_col])
