    def _organize_contract_groups(self) -> list:
        """Organize 合同组拼接 to get the full list of contract groups."""
        sheet = self._get_sheet('合同组拼接')
        headers = sheet['headers']
        rows = sheet['rows']

        groups = []
        for row in rows:
            if not row:
                continue
            group = {}
            for i, h in enumerate(headers):
                if h and i < len(row):
                    group[h] = row[i]
            # 保留所有含预测组ID的行（新业务/现有业务组分别由对应名称ID列区分）
            if group.get('预测组ID'):
                groups.append(group)

        return groups

    def _load_nb_fixture(self) -> dict:
        """Load the oracle-sourced new-business input fixture (built by scripts/build_nb_fixture.py
        from the authoritative verification workbook). Cached on the instance.

        JSON serialises dict keys as strings, so the month-index keys (1..60) of the pattern
        tables and the discount curve come back as '1'..'60'. Coerce numeric keys back to int
        so the engine's int-keyed lookups (earn[1], disc_end[midx], ...) match."""
        if getattr(self, '_nb_fix', None) is None:
            NB_FIXTURE = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                                      'data_input', 'fixtures', 'new_business_inputs.json')
            self._nb_fix = {}
            if os.path.exists(NB_FIXTURE):
                try:
                    with open(NB_FIXTURE, encoding='utf-8') as _f:
                        raw = json.load(_f)

                        # JSON serialises dict keys as strings. The pattern tables are
                        # {group_key: {month: value}}; only the INNER month keys must become
                        # ints. Group keys (险类 codes like '32', 预测组ID, 预测组) must stay
                        # strings, otherwise lookups such as und_incur.get('32') would miss.
                        def _intkeys(d):
                            return {((int(k) if isinstance(k, str) and k.lstrip('-').isdigit() else k)): v
                                    for k, v in d.items()}

                        for t in ['earn', 'prem_mode', 'iacf_mode', 'ep', 'maint', 'invest',
                                  'und_incur', 'cum', 'reins', 'recov', 'io_indir']:
                            if t in raw and isinstance(raw[t], dict):
                                raw[t] = {g: _intkeys(m) for g, m in raw[t].items()}
                        for t in ['disc_end', 'disc_begin', 'intrate']:
                            if t in raw and isinstance(raw[t], dict):
                                raw[t] = _intkeys(raw[t])
                        # keynew stays as-is (group key + field-name inner keys)
                        self._nb_fix = raw
                except Exception:
                    self._nb_fix = {}
        return self._nb_fix

