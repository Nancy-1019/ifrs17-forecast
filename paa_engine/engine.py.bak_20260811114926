    def _calculate_paa_new(self, cf: dict, eval_date, forecast_period: int,
                           rate_curve: dict, prev_paa: dict = None) -> dict:
        """Return the precomputed faithful aggregate (computed in _calculate_cashflows_new)."""
        return cf.get('paa', {})

    def _calculate_paa_existing(self, cf: dict, eval_date, forecast_period: int,
                                rate_curve: dict, prev_paa: dict = None) -> dict:
        """Existing-business PAA metrics (faithful port).

        The full 3600-row development triangle and the PAA aggregate are computed in
        _calculate_cashflows_existing; this returns the precomputed result, matching
        PAA计算_现有业务整理 输出_* columns (verified 0 diff vs IFRS17财务预测_改造版_0729_VBA)."""
        return cf.get('paa', {}) if cf else {}

    # ============================================================
    # Step 6: Main calculation runner
    # ============================================================

    def run(self, scenario: str = '基础情景', forecast_periods_override: int = None,
            progress_callback=None) -> CalculationResult:
        """Run the full PAA calculation pipeline.

        Args:
            scenario: Selected scenario name (e.g., '基础情景', '情景1')
            forecast_periods_override: Override forecast periods from UI selector.
                When provided, overrides the value from 基本信息 sheet.
                Controls how many new contract group instances are generated
                (base_groups × forecast_periods).
            progress_callback: Optional callback for progress reporting.
                Signature: callback(stage:int, stage_name:str, current:int,
                total:int, scenario:str, message:str, percent:float)

        Returns:
            CalculationResult with all output tables
        """
        _prog_state = {'stage': 0, 'name': '', 'cur': 0, 'tot': 1, 'pct': 0.0}

        def _prog(stage, name, cur, tot, msg, pct):
            _prog_state.update(stage=stage, name=name, cur=cur, tot=tot, pct=pct)
            if progress_callback:
                try:
                    progress_callback(stage, name, cur, tot, scenario, msg, pct)
                except Exception:
                    pass

        def _prog_msg(message):
            # 重循环内的进度心跳：仅更新 message，保持当前阶段/百分比不变
            s = _prog_state
            _prog(s['stage'], s['name'], s['cur'], s['tot'], message, s['pct'])

        # 看门狗：在重计算循环里周期性检查内存与耗时，超限则主动中止（保护 gunicorn 不被 OOM 拖垮）
        wd = _CalcWatchdog(
            mem_limit_mb=1100.0, time_limit_s=600.0, tick_every=400,
            scenario=scenario, on_tick=_prog_msg,
        )

        try:
            self._log(f'开始PAA计算，选定场景: {scenario}')
            _prog(0, '初始化', 0, 1, f'选定场景: {scenario}', 0)

            # 1. Get basic info
            basic_info = self._get_basic_info()
            _prog(1, '基本信息', 1, 1, '读取基本信息与评估时点', 2)
            eval_date = basic_info['eval_date']
            forecast_periods = basic_info['forecast_periods']

            # Override forecast periods from UI selector
            if forecast_periods_override is not None and forecast_periods_override > 0:
                forecast_periods = forecast_periods_override
                self._log(f'预测期数由界面选择覆盖为: {forecast_periods} 个月')

            self._log(f'评估时点: {eval_date}, 预测期数: {forecast_periods}')

            if eval_date is None:
                eval_date = datetime.datetime(2026, 6, 30)

            # 2. Get scenario parameters
            scenario_params = self._get_scenario_params(scenario)
            self._log(f'场景参数加载完成: {len(scenario_params)} 个月度参数')
            _prog(2, '情景参数', 1, 1, f'加载 {len(scenario_params)} 个月度情景参数', 4)

            # 3. Process interest rate curve
            rate_curve = self._process_interest_rate_curve(eval_date, forecast_periods, scenario_params)
            self._log(f'利率曲线加工完成: {len(rate_curve["discount_factor_end"])} 个月度折现因子')
            _prog(3, '利率曲线', 1, 1, '加工利率曲线与折现因子', 8)

            # 4. Organize inputs
            new_assumptions = self._organize_key_assumptions_new(eval_date, scenario_params)
            existing_assumptions = self._organize_key_assumptions_existing(eval_date, scenario_params)
            self._log(f'输入整理完成: 新业务 {len(new_assumptions)} 组, 现有业务 {len(existing_assumptions)} 组')
            _prog(4, '输入整理', 1, 1, f'新业务 {len(new_assumptions)} 组, 现有业务 {len(existing_assumptions)} 组', 12)

            # Store organized inputs
            self.result.input_organized = {
                '新业务假设': new_assumptions,
                '现有业务假设': existing_assumptions,
                '利率曲线': {
                    '月度折现因子_期末': rate_curve['discount_factor_end'],
                    '月度远期利率': rate_curve['monthly_rate'],
                },
                '选定场景': scenario,
                '评估时点': str(eval_date),
                '预测期数': forecast_periods,
            }

            # 5. Calculate new business
            self._log('开始新业务PAA计算...')
            new_predict_rows = []
            new_summary_rows = []
            _new_total = len(new_assumptions) * forecast_periods if forecast_periods else 0
            _new_done = 0

            for gi, group in enumerate(new_assumptions):
                pred_group_id = str(group.get('预测组ID', ''))
                pred_group = str(group.get('预测组', ''))
                act_class = group.get('精算险类')
                biz_type = str(group.get('业务类型', '直保或分入'))
                write_month = _to_int(group.get('评估期开始业务预期写入时间（月）', 1))

                prev_paa = None
                for period in range(1, forecast_periods + 1):
                    wd.tick()
                    # Calculate cashflows
                    cf = self._calculate_cashflows_new(group, eval_date, period, rate_curve, scenario_params, watchdog=wd)

                    # Calculate PAA metrics
                    paa = self._calculate_paa_new(cf, eval_date, period, rate_curve, prev_paa)

                    # Build prediction row
                    pred_date = _eomonth(eval_date, period)
                    row = {
                        '子合同组合名称': act_class,
                        '评估期开始业务预期写入时间（月）': write_month,
                        '预测组': pred_group,
                        '预测组ID': pred_group_id,
                        '直保或分入/分出': biz_type,
                        '精算险类': act_class,
                        '评估日': eval_date,
                        '预测时点': pred_date,
                        '预测时点年初': datetime.datetime(pred_date.year - 1, 12, 31),
                        '预测间隔': period,
                        '数据来源表': f'新业务预期现金流_{period}',
                        '当期确认比例': cf['confirm_ratio'],
                        '获取现金流摊销比例': cf['amortization_ratio'],
                        '投资成分比例%': cf['investment_ratio'],
                        '预期摊回比例%': cf.get('ceding_recover_ratio', 0),
                        '当月计息利率': rate_curve['monthly_rate'].get(period, 0),
                        # 验证文件 PAA计算_新业务整理：
                        # 直保/分入组 保费收入/获取费用 = 输入假设 U/V；
                        # 分出组则 VBA 输出列取现金流输出（收到保费 / 支付 IACF）。
                        '保费收入': cf['premium_income'],
                        '获取费用': cf['acquisition_cost'],
                    }
                    row.update(paa)
                    if biz_type == '分出':
                        row['保费收入'] = paa.get('输出_现金流_收到的保费', row['保费收入'])
                        row['获取费用'] = paa.get('输出_现金流_支付的IACF', row['获取费用'])
                    new_predict_rows.append(row)
                    new_summary_rows.append(row)
                    prev_paa = paa
                    _new_done += 1
                    if _new_total:
                        _prog(5, '新业务PAA计算', _new_done, _new_total,
                              f'组 {gi+1}/{len(new_assumptions)} · 时点 {period}/{forecast_periods}',
                              12 + 33 * (_new_done / _new_total))

            self._log(f'新业务计算完成: {len(new_predict_rows)} 行')
            _prog(5, '新业务PAA计算', _new_total, _new_total, '新业务计算完成', 45)

            # 6. Calculate existing business
            self._log('开始现有业务PAA计算...')
            existing_predict_rows = []
            existing_summary_rows = []
            _ex_total = len(existing_assumptions) * forecast_periods if forecast_periods else 0
            _ex_done = 0

            for gi, group in enumerate(existing_assumptions):
                group_id = str(group.get('合同组ID', ''))
                group_name = str(group.get('合同组名称', ''))
                pred_group_id = str(group.get('预测组ID', ''))
                pred_group = str(group.get('预测组', ''))
                existing_group_id = str(group.get('现有业务预测组ID', ''))
                existing_group_name = str(group.get('现有业务预测组', ''))
                act_class = group.get('精算险类')
                biz_type = str(group.get('直保或分入/分出', '直保或分入'))
                write_month = _to_int(group.get('评估期开始业务预期写入时间（月）', 0))

                prev_paa = None
                for period in range(1, forecast_periods + 1):
                    wd.tick()
                    cf = self._calculate_cashflows_existing(group, eval_date, period, rate_curve, scenario_params, watchdog=wd)
                    paa = self._calculate_paa_existing(cf, eval_date, period, rate_curve, prev_paa)

                    pred_date = _eomonth(eval_date, period)
                    row = {
                        '精算险类': act_class,
                        '评估期开始业务预期写入时间（月）': write_month,
                        '合同组名称': group_name,
                        '合同组ID': group_id,
                        '现有业务预测组': existing_group_name,
                        '现有业务预测组ID': existing_group_id,
                        '预测组': pred_group,
                        '预测组ID': pred_group_id,
                        '直保或分入/分出': biz_type,
                        '评估日': eval_date,
                        '预测时点': pred_date,
                        '预测时点年初': datetime.datetime(pred_date.year - 1, 12, 31),
                        '预测间隔': period,
                        '数据来源表': f'现有业务预期现金流_{period}',
                        '当期确认比例': cf['confirm_ratio'],
                        '获取现金流摊销比例': cf['amortization_ratio'],
                        '当月计息利率': rate_curve['monthly_rate'].get(period, 0),
                    }
                    row.update(paa)
                    existing_predict_rows.append(row)
                    existing_summary_rows.append(row)
                    prev_paa = paa
                    _ex_done += 1
                    if _ex_total:
                        _prog(6, '现有业务PAA计算', _ex_done, _ex_total,
                              f'组 {gi+1}/{len(existing_assumptions)} · 时点 {period}/{forecast_periods}',
                              45 + 35 * (_ex_done / _ex_total))

            self._log(f'现有业务计算完成: {len(existing_predict_rows)} 行')
            _prog(6, '现有业务PAA计算', _ex_total, _ex_total, '现有业务计算完成', 80)

            # 7. Generate combined summary
            self._log('生成汇总表...')
            combined_rows = self._generate_combined_summary(
                new_summary_rows, existing_summary_rows, eval_date, forecast_periods
            )
            self._log(f'汇总表生成完成: {len(combined_rows)} 行')
            _prog(7, 'PAA结果汇总', 1, 1, f'汇总 {len(combined_rows)} 行', 90)

            # 8. Generate financial statements
            financial_v2 = self._generate_financial_statements(combined_rows, forecast_periods, eval_date, watchdog=wd)
            self._log(f'财务报表生成完成: MTD/YTD结构化数据')
            _prog(8, '输出财务报表', 1, 1, '生成 MTD/YTD 财务报表', 98)

            # Store results
            self.result.scenarios = self.get_scenarios()
            self.result.selected_scenario = scenario
            self.result.new_business_predict = new_predict_rows
            self.result.existing_business_predict = existing_predict_rows
            self.result.new_business_summary = new_summary_rows
            self.result.existing_business_summary = existing_summary_rows
            self.result.combined_summary = combined_rows
            self.result.financial_statements = []  # legacy, now using financial_statements_v2
            self.result.financial_statements_v2 = financial_v2
            self.result.success = True
            self._log('PAA计算全部完成!')
            _prog(8, '完成', 1, 1, 'PAA计算全部完成', 100)

            return self.result

        except Exception as e:
            import traceback
            self._log(f'计算错误: {str(e)}')
            self._log(traceback.format_exc())
            self.result.success = False
            self.result.error = str(e)
            return self.result

    def organize_inputs(self, scenario: str = '基础情景') -> dict:
        """轻量输入整理：仅执行基本信息/情景参数/利率曲线/关键假设整理，
        不进行 PAA 现金流三角计算。用于"输入整理"页情景对比（快速，秒级）。"""
        basic_info = self._get_basic_info()
        eval_date = basic_info['eval_date']
        forecast_periods = basic_info['forecast_periods']
        if eval_date is None:
            eval_date = datetime.datetime(2026, 6, 30)
        scenario_params = self._get_scenario_params(scenario)
        rate_curve = self._process_interest_rate_curve(eval_date, forecast_periods, scenario_params)
        new_assumptions = self._organize_key_assumptions_new(eval_date, scenario_params)
        existing_assumptions = self._organize_key_assumptions_existing(eval_date, scenario_params)
        return {
            '新业务假设': new_assumptions,
            '现有业务假设': existing_assumptions,
            '利率曲线': {
                '月度折现因子_期末': rate_curve['discount_factor_end'],
                '月度远期利率': rate_curve['monthly_rate'],
            },
            '选定场景': scenario,
            '评估时点': str(eval_date),
            '预测期数': forecast_periods,
            '情景压力参数': scenario_params,
        }

    def _generate_combined_summary(self, new_rows: list, existing_rows: list,
                                    eval_date, forecast_periods: int) -> list:
        """Generate PAA计算_汇总 by combining new and existing business."""
        summary = []

        # Get contract group splicing info
        contract_groups = self._organize_contract_groups()
        group_info = {}
        for cg in contract_groups:
            gid = str(cg.get('预测组ID', ''))
            group_info[gid] = cg

        # Process new business
        for row in new_rows:
            group_id = str(row.get('预测组ID', ''))
            period = row.get('预测间隔', 1)
            cg = group_info.get(group_id, {})

            combined = {
                '合同组ID名称': group_id,
                '预测间隔': period,
                '排列组合项': f'{group_id}&{period}',
                '合同组名称': row.get('预测组', ''),
                '评估期开始业务预期写入时间（月）': row.get('评估期开始业务预期写入时间（月）', 1),
                '预测间隔_排列': period,
                '合同组ID': group_id,
                '子合同组合名称': row.get('子合同组合名称', ''),
                '合同组合名称': row.get('预测组', ''),
                '业务类型': row.get('直保或分入/分出', ''),
                '精算险类': row.get('精算险类', ''),
                '评估日': eval_date,
                '预测时点': row.get('预测时点', ''),
            }

            # Sum output columns from new and existing (for same group_id and period)
            for col in SUMMARY_COLS[13:]:  # Skip first 13 info columns
                if col and col.startswith('输出_'):
                    new_val = row.get(col, 0)
                    # Find matching existing business row
                    ex_val = 0
                    for ex_row in existing_rows:
                        if str(ex_row.get('合同组ID', '')).replace('&0', '&1') == group_id and ex_row.get('预测间隔') == period:
                            ex_val = ex_row.get(col, 0)
                            break
                    combined[col] = _to_float(new_val) + _to_float(ex_val)
                elif col:
                    combined[col] = row.get(col, 0)

            summary.append(combined)

        # Process existing-only groups (not in new business)
        new_group_ids = set(str(r.get('预测组ID', '')) for r in new_rows)
        for row in existing_rows:
            group_id = str(row.get('合同组ID', ''))
            if group_id not in new_group_ids:
                period = row.get('预测间隔', 1)
                combined = {
                    '合同组ID名称': group_id,
                    '预测间隔': period,
                    '排列组合项': f'{group_id}&{period}',
                    '合同组名称': row.get('合同组名称', ''),
                    '评估期开始业务预期写入时间（月）': row.get('评估期开始业务预期写入时间（月）', 0),
                    '预测间隔_排列': period,
                    '合同组ID': group_id,
                    '子合同组合名称': row.get('精算险类', ''),
                    '合同组合名称': row.get('合同组名称', ''),
                    '业务类型': row.get('直保或分入/分出', ''),
                    '精算险类': row.get('精算险类', ''),
                    '评估日': eval_date,
                    '预测时点': row.get('预测时点', ''),
                }
                for col in SUMMARY_COLS[13:]:
                    if col:
                        combined[col] = row.get(col, 0)
                summary.append(combined)

        return summary

