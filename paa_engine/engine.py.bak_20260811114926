class PAAEngine:
    """IFRS17 PAA Calculation Engine.

    Usage:
        engine = PAAEngine(dock_sheets, excel_sheets)
        scenarios = engine.get_scenarios()
        result = engine.run(scenario='基础情景')
    """

    MAX_DEV_MONTHS = 60  # Maximum development months per accident period

    def __init__(self, dock_sheets: dict = None, excel_sheets: dict = None):
        """
        Args:
            dock_sheets: {sheet_name: {'headers': [...], 'rows': [[...], ...]}}
            excel_sheets: same format
        """
        self.dock = dock_sheets or {}
        self.excel = excel_sheets or {}
        self.result = CalculationResult()
        self._cache = {}

    def _get_sheet(self, name: str, source: str = None) -> dict:
        """Get sheet data from dock or excel."""
        if source == 'dock':
            return self.dock.get(name, {'headers': [], 'rows': []})
        elif source == 'excel':
            return self.excel.get(name, {'headers': [], 'rows': []})
        # Try both
        if name in self.dock:
            return self.dock[name]
        if name in self.excel:
            return self.excel[name]
        return {'headers': [], 'rows': []}

    def _log(self, msg: str):
        self.result.calc_logs.append(msg)

    # ============================================================
    # Step 1: Scenario Management
    # ============================================================

    def get_scenarios(self) -> list:
        """Get available scenarios from 压力情景配置表."""
        sheet = self._get_sheet('压力情景配置表')
        if not sheet['rows']:
            return [
                {'value': '情景0', 'label': '情景0', 'description': '基础情景', 'conditions': {}},
            ]

        headers = sheet['headers']
        # Find columns: 情景, 情景描述
        scenario_col = -1
        desc_col = -1
        month_col = -1
        for i, h in enumerate(headers):
            if h == '情景':
                scenario_col = i
            elif h == '情景描述':
                desc_col = i
            elif h == '预测月份':
                month_col = i

        if scenario_col < 0:
            return [{'value': '情景0', 'label': '情景0', 'description': '基础情景', 'conditions': {}}]

        # Stress parameter columns to display (exclude metadata columns)
        param_cols = {}
        for i, h in enumerate(headers):
            if h and h not in ('评估时点', '情景', '情景描述', '预测月份'):
                param_cols[h] = i

        seen = set()
        scenario_params = {}
        scenario_desc = {}
        for row in sheet['rows']:
            if scenario_col >= len(row) or row[scenario_col] is None:
                continue
            val = str(row[scenario_col])
            desc = str(row[desc_col]) if desc_col >= 0 and desc_col < len(row) and row[desc_col] else val
            scenario_desc[val] = desc
            if val not in seen:
                seen.add(val)
                scenario_params[val] = {}
            # Aggregate non-zero parameters across months (take first month as representative)
            if month_col < 0 or (month_col < len(row) and _to_int(row[month_col]) == 1):
                for param_name, col_idx in param_cols.items():
                    if col_idx < len(row) and row[col_idx] is not None:
                        v = _to_float(row[col_idx])
                        if v != 0:
                            scenario_params[val][param_name] = v

        scenarios = []
        for val in seen:
            scenarios.append({
                'value': val,
                'label': val,
                'description': scenario_desc.get(val, val),
                'conditions': scenario_params.get(val, {}),
            })

        # Sort by scenario number (情景0, 情景1, 情景2...)
        import re
        def scenario_sort_key(s):
            m = re.search(r'(\d+)', s.get('value', ''))
            return int(m.group(1)) if m else 999
        scenarios.sort(key=scenario_sort_key)

        return scenarios if scenarios else [{'value': '情景0', 'label': '情景0', 'description': '基础情景', 'conditions': {}}]

    def _get_scenario_params(self, scenario: str) -> dict:
        """Get scenario parameters (stress adjustments) for each forecast month."""
        sheet = self._get_sheet('压力情景配置表')
        headers = sheet['headers']
        rows = sheet['rows']

        # Column indices for stress parameters
        param_cols = {
            '原保险保费增长': 'premium_growth',
            '预期赔付率上升': 'loss_ratio_adj',
            '预期费用率上升': 'expense_ratio_adj',
            '即期利率变动': 'rate_adjustment',
        }

        col_map = {}
        for i, h in enumerate(headers):
            if h in param_cols:
                col_map[param_cols[h]] = i

        scenario_col = -1
        month_col = -1
        for i, h in enumerate(headers):
            if h == '情景':
                scenario_col = i
            elif h == '预测月份':
                month_col = i

        # Build params by month
        params_by_month = {}
        for row in rows:
            if scenario_col < len(row) and str(row[scenario_col]) == scenario:
                month = _to_int(row[month_col]) if month_col >= 0 and month_col < len(row) else 0
                params = {}
                for param_name, col_idx in col_map.items():
                    params[param_name] = _to_float(row[col_idx]) if col_idx < len(row) else 0.0
                params_by_month[month] = params

        return params_by_month

    def _get_basic_info(self) -> dict:
        """Read 基本信息 sheet."""
        sheet = self._get_sheet('基本信息')
        headers = sheet['headers']
        rows = sheet['rows']

        info = {
            'update_date': None,
            'eval_date': None,
            'forecast_periods': 1,
            'updater': '',
        }

        if rows:
            row = rows[0]
            for i, h in enumerate(headers):
                if h == '更新日期' and i < len(row):
                    info['update_date'] = row[i]
                elif h == '评估时点' and i < len(row):
                    info['eval_date'] = self._parse_date(row[i])
                elif h == '预测期数' and i < len(row):
                    info['forecast_periods'] = _to_int(row[i])
                elif h == '更新人员' and i < len(row):
                    info['updater'] = str(row[i]) if row[i] else ''

        return info

    def _parse_date(self, val) -> datetime.datetime:
        """Parse various date formats into datetime object."""
        if val is None or val == '':
            return None
        if isinstance(val, datetime.datetime):
            return val
        if isinstance(val, datetime.date):
            return datetime.datetime(val.year, val.month, val.day)
        # Try numeric (Excel serial date)
        if isinstance(val, (int, float)):
            try:
                if 30000 < val < 80000:
                    # Excel serial date
                    return datetime.datetime(1899, 12, 30) + datetime.timedelta(days=int(val))
            except (ValueError, OverflowError):
                pass
        # Try string parsing
        s = str(val).strip()
        # ISO format: 2026-06-30T00:00:00
        for fmt in ['%Y-%m-%dT%H:%M:%S', '%Y-%m-%d %H:%M:%S', '%Y-%m-%d',
                     '%Y/%m/%d', '%Y/%m/%d %H:%M:%S', '%Y%m%d']:
            try:
                return datetime.datetime.strptime(s, fmt)
            except ValueError:
                continue
        # Try regex extraction
        import re
        m = re.match(r'(\d{4})[\/\-.](\d{1,2})[\/\-.](\d{1,2})', s)
        if m:
            try:
                return datetime.datetime(int(m.group(1)), int(m.group(2)), int(m.group(3)))
            except ValueError:
                pass
        return None

    def _load_monthly_input_sheet(self, sheet_name: str, key_col: int = 2) -> dict:
        """Load a monthly input sheet (费用输入项/其他输入项) into {key: {period: value}}.

        Args:
            sheet_name: Name of the sheet to load.
            key_col: Column index containing the data type/key (default 2).

        Returns:
            Dict mapping data type to a dict of {period_index: value}.
            Period index starts at 1 for the first numeric column.
        """
        sheet = self._get_sheet(sheet_name)
        headers = sheet.get('headers', [])
        rows = sheet.get('rows', [])
        if not rows:
            return {}

        result = {}
        for row in rows:
            if not row or key_col >= len(row) or row[key_col] is None:
                continue
            key = str(row[key_col]).strip()
            values = {}
            # Numeric columns start after the header columns (first 3 cols)
            for period_idx, val in enumerate(row[key_col + 1:], start=1):
                values[period_idx] = _to_float(val)
            result[key] = values
        return result

    def _get_expense_input(self, key: str, period: int) -> float:
        """Get a single period value from 费用输入项."""
        if not hasattr(self, '_expense_inputs'):
            self._expense_inputs = self._load_monthly_input_sheet('费用输入项', key_col=2)
        return self._expense_inputs.get(key, {}).get(period, 0.0)

    def _get_other_input(self, key: str, period: int) -> float:
        """Get a single period value from 其他输入项."""
        if not hasattr(self, '_other_inputs'):
            self._other_inputs = self._load_monthly_input_sheet('其他输入项', key_col=2)
        return self._other_inputs.get(key, {}).get(period, 0.0)

