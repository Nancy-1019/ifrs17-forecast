    def _build_monthly_lookup(self, sheet: dict, key_col_idx: int = 0) -> dict:
        """Build lookup: {key: {month_num: value}} for monthly data sheets."""
        headers = sheet['headers']
        rows = sheet['rows']
        lookup = {}

        # Find month columns (columns with numeric headers after text columns)
        month_cols = {}
        for i, h in enumerate(headers):
            if h is not None and i >= key_col_idx + 1:
                try:
                    month_num = int(float(h))
                    month_cols[month_num] = i
                except (ValueError, TypeError):
                    pass

        for row in rows:
            if key_col_idx < len(row) and row[key_col_idx] is not None:
                key = str(row[key_col_idx])
                if key not in lookup:
                    lookup[key] = {}
                    for month_num, col_idx in month_cols.items():
                        if col_idx < len(row):
                            lookup[key][month_num] = _to_float(row[col_idx])

        return lookup

    def _lookup_monthly(self, lookup: dict, key, month: int, default: float = 0.0) -> float:
        """Look up a monthly value from a lookup dict."""
        if str(key) in lookup:
            return lookup[str(key)].get(month, default)
        return default

    # ============================================================
    # Step 3: Interest Rate Curve Processing
    # ============================================================

    def _process_interest_rate_curve(self, eval_date, forecast_periods: int, scenario_params: dict) -> dict:
        """Process 即期利率曲线 to generate discount factors.

        Returns dict with:
        - 'monthly_rate': {month: forward_rate}
        - 'discount_factor_end': {month: discount_factor}
        - 'discount_factor_begin': {month: discount_factor}
        - 'annual_rate_forecast': {month: adjusted_annual_rate}
        """
        # Read 即期利率曲线
        spot_sheet = self._get_sheet('即期利率曲线')
        spot_headers = spot_sheet['headers']
        spot_rows = spot_sheet['rows']

        # Build annual rate lookup by year
        annual_rates = {}
        for row in spot_rows:
            if row and len(row) > 2:
                # Find year and rate columns
                year_col = -1
                rate_col = -1
                for i, h in enumerate(spot_headers):
                    if h and '年度' in str(h):
                        year_col = i
                    elif h and ('利率' in str(h) or '即期' in str(h)):
                        rate_col = i
                if year_col >= 0 and rate_col >= 0 and year_col < len(row):
                    year = _to_int(row[year_col])
                    rate = _to_float(row[rate_col])
                    annual_rates[year] = rate

        # Read 初始确认利率曲线 for existing business
        init_rate_sheet = self._get_sheet('初始确认利率曲线')
        init_rate_headers = init_rate_sheet['headers']
        init_rate_rows = init_rate_sheet['rows']

        # Build initial confirmation rate lookup by contract group and month
        init_rates = {}  # {contract_group_id: {month: rate}}
        for row in init_rate_rows:
            if row and len(row) > 3:
                # First 3-4 columns are headers, rest are contract group columns
                # Row 3 (index 2) has contract group IDs
                pass  # Simplified - use spot rates for all

        # 折现因子只需覆盖开发三角的最大月度索引（60x60 三角 midx 上限≈118），
        # 而非按"30 年"盲目铺满——360 的下限是冗余浪费且易误导（见引擎说明）。
        # 取"预测期×12"与三角深度下限 120 的较大者：既尊重界面预测期选择又保证正确性。
        max_months = max(forecast_periods * 12, 120)

        result = {
            'monthly_rate': {},
            'discount_factor_end': {},
            'discount_factor_begin': {},
            'annual_rate_forecast': {},
            'annual_rate_eval': {},
        }

        # Month 0 = eval_date: no discounting
        result['discount_factor_end'][0] = 1.0
        result['discount_factor_begin'][0] = 1.0
        result['monthly_rate'][1] = 0.0  # Will be set properly in loop

        for month in range(1, max_months + 1):
            # Determine year
            if month % 12 == 0:
                year = month // 12
            else:
                year = month // 12 + 1

            # Get base annual rate
            base_rate = annual_rates.get(year, annual_rates.get(1, 0.03))

            # Apply scenario rate adjustment
            # 压力表的"预测月份"表示预测年序(1..5)，需将月序号映射到所属年，
            # 使即期利率变动作用于该年的全部 12 个月（修正原先仅作用于前 N 个月的错位）。
            rate_adj_year = (month - 1) // 12 + 1
            rate_adj = scenario_params.get(rate_adj_year, {}).get('rate_adjustment', 0.0)
            adj_rate = base_rate * (1 + rate_adj)

            result['annual_rate_forecast'][month] = adj_rate
            result['annual_rate_eval'][month] = base_rate

            # Monthly discount factors
            result['discount_factor_end'][month] = (1 + adj_rate / 12) ** (-month)
            result['discount_factor_begin'][month] = (1 + adj_rate / 12) ** (-month + 1)

            # Monthly forward rate
            if month > 1:
                df_end_prev = result['discount_factor_end'][month - 1]
                df_end_curr = result['discount_factor_end'][month]
                if df_end_curr > 0:
                    result['monthly_rate'][month] = df_end_prev / df_end_curr - 1
                else:
                    result['monthly_rate'][month] = adj_rate / 12
            else:
                result['monthly_rate'][month] = adj_rate / 12

        return result

    # ============================================================
    # Step 4: Cashflow Calculation
    # ============================================================

    def _calculate_cashflows_new(self, group: dict, eval_date, forecast_period: int,
                                  rate_curve: dict, scenario_params: dict,
                                  watchdog=None) -> dict:
        """Faithful new-business PAA (port of scripts/vba_faithful_new.py, verified 0-diff
        vs IFRS17财务预测_改造版_0729_VBA PAA计算_新业务整理 输出_* columns).

        Reconstructs the 60x60 development triangle (anchored at the prediction time, since
        new business has no opening balances) and aggregates per the PAA计算_新业务预测
        formulas. The aggregated result is stored under cf['paa'].
        """
        act_class = str(group.get('精算险类', ''))
        biz_type = str(group.get('业务类型', '直保或分入'))
        分出 = (biz_type == '分出')
        预测组 = str(group.get('预测组', ''))
        预测组ID = str(group.get('预测组ID', ''))
        PERIOD = forecast_period
        pred_time = _eomonth(eval_date, PERIOD)   # H2 = 预测时点
        G2 = eval_date                            # 评估日

        # ---- U / V / CC from the authoritative 合同组关键假设_新业务 fixture ----
        U = _to_float(group.get('保费收入', 0))
        V = _to_float(group.get('获取费用', 0))
        CC = _to_float(group.get('CC', 0))
        Ueff = V if 分出 else U

        # ---- 情景压力（按预测时点所在年取压力值）----
        # 预期赔付率上升 -> 提高预期赔付（incurred claims）；预期费用率上升 -> 提高维持费用与获取费用。
        # 注意：U/V/CC 已是"原保险保费增长"在输入整理阶段缩放后的结果，此处不再重复缩放保费。
        _yr = (forecast_period - 1) // 12 + 1
        _sp = scenario_params.get(_yr, {})
        _loss_ratio_adj = _sp.get('loss_ratio_adj', 0.0)
        _expense_ratio_adj = _sp.get('expense_ratio_adj', 0.0)
        V_eff = V * (1 + _expense_ratio_adj)   # 获取费用受费用率上升影响

        # ---- build input lookups (cached on self for the whole run) ----
        if not hasattr(self, '_fl_new'):
            self._fl_new = {}
        fl = self._fl_new

        def monthly(sheet, key_header=None):
            cache_key = sheet if key_header is None else f"{sheet}#{key_header}"
            if cache_key in fl:
                return fl[cache_key]
            s = self._get_sheet(sheet)
            hdr = s['headers']
            rows = s['rows']
            key_idx = None
            if key_header is not None:
                for i, h in enumerate(hdr):
                    if h == key_header:
                        key_idx = i
                        break
            else:
                for i, h in enumerate(hdr):
                    if h in ('预测组', '精算险类'):
                        key_idx = i
                        break
            if key_idx is None:
                key_idx = 0
            mcols = {}
            for i, h in enumerate(hdr):
                if i > key_idx and h is not None:
                    try:
                        m = _to_int(h)
                        mcols[m] = i
                    except Exception:
                        pass
            out = {}
            for r in rows:
                if key_idx >= len(r) or r[key_idx] is None:
                    continue
                k = _norm_key(r[key_idx])
                d = {}
                for m, ci in mcols.items():
                    if ci < len(r) and r[ci] is not None:
                        try:
                            d[m] = float(r[ci])
                        except Exception:
                            d[m] = 0.0
                out[k] = d
            fl[cache_key] = out
            return out

        # ---- authoritative new-business inputs (oracle-sourced fixture) ----
        nb = self._load_nb_fixture()
        ep = nb['ep']                 # keyed by 预测组
        maint = nb['maint']           # keyed by 险类
        recov = nb['recov']           # keyed by 险类
        invest = nb['invest']         # keyed by 预测组
        prem_mode = nb['prem_mode']   # keyed by 预测组ID
        iacf_mode = nb['iacf_mode']   # keyed by 预测组ID
        earn = nb['earn']             # keyed by 预测组ID
        und_incur = nb['und_incur']   # keyed by 险类
        cum = nb['cum']               # keyed by 险类
        reins = nb['reins']           # keyed by 险类
        io_indir = nb['io_indir']     # keyed by 险类
        riskadj = nb['riskadj']       # keyed by 险类
        disc_end = nb['disc_end']
        disc_begin = nb['disc_begin']
        intrate = nb['intrate']

        def get(d, k, default=0.0):
            if d is None:
                return default
            v = d.get(k)
            if v is None:
                return default
            try:
                return float(v)
            except Exception:
                return default

        def gk(d, m):
            # try 险类 then 预测组 (covers oracle keying for ep/invest/maint)
            return get(d.get(act_class, {}), m) or get(d.get(预测组, {}), m)

        def gk_str(d, key):
            return get(d.get(act_class, {}), key) or get(d.get(预测组, {}), key)

        pr = gk(ep, PERIOD)
        mr = 0.0 if 分出 else gk(maint, PERIOD)
        mr_eff = mr * (1 + _expense_ratio_adj)   # 维持费用率受费用率上升影响
        nra_und = gk_str(riskadj, '未到期风险调整%')
        nra_inc = gk_str(riskadj, '未决风险调整%')
        reins_r = 0.0 if not 分出 else gk(reins, PERIOD)
        io_indir_r = 0.0 if 分出 else gk(io_indir, PERIOD)
        recov_r = 0.0 if 分出 else gk(recov, PERIOD)
        invest_r = gk(invest, PERIOD)

        # discount / int rate for the period (oracle source: 即期利率曲线加工)
        P = intrate.get(PERIOD, 0.0)

        # precompute denom_adv (sum of earn over block1 rows where AB > H2)
        denom_adv = 0.0
        for d in range(0, 60):
            W = d + 1  # a == 1 block only
            AB = _eomonth(G2, W)
            if AB > pred_time and W > PERIOD:
                denom_adv += get(earn.get(预测组ID, {}), W)
        # precompute denom_AK (sum of und_incur[d+1] over block1 rows where AD > H2)
        denom_AK = 0.0
        for d in range(0, 60):
            AD1 = _eomonth(pred_time, d)
            if AD1 > pred_time:
                denom_AK += get(und_incur.get(act_class, {}), d + 1)

        rows = []
        for a in range(1, 61):
            for d in range(0, 60):
                if watchdog is not None:
                    watchdog.tick(f'新业务 · 开发三角 a={a}/60 d={d}/59')
                W = d + 1 if a == 1 else None
                AC = _eomonth(pred_time, a - 1)
                AD = _eomonth(AC, d)
                AB = _eomonth(G2, W) if W is not None else None
                AH = get(earn.get(预测组ID, {}), a)
                AG = get(earn.get(预测组ID, {}), W) if W is not None else 0.0
                AE_mode = get(prem_mode.get(预测组ID, {}), W) if W is not None else 0.0
                AF_mode = get(iacf_mode.get(预测组ID, {}), W) if W is not None else 0.0
                ai_idx = d
                AI = get(und_incur.get(act_class, {}), ai_idx) * (1 + _loss_ratio_adj)
                ai_ibnr = d + 1
                AI_ibnr = get(und_incur.get(act_class, {}), ai_ibnr) * (1 + _loss_ratio_adj)
                adv = (CC * AH / denom_adv) if (AC > pred_time and denom_adv != 0) else 0.0
                CA = Ueff * AH + adv
                AR = pr * CA * AI if AC > pred_time else 0.0
                CB = U * AG + ((CC * AG / denom_adv) if (AB is not None and AB > pred_time and denom_adv != 0) else 0.0)
                AS = CB * mr_eff
                AT = (AR + AS) * nra_und
                AU = pr * CA if AC <= pred_time else 0.0
                al_cum = get(cum.get(act_class, {}), PERIOD - a + 1) if (PERIOD - a + 1) >= 1 else 0.0
                AV = AU * al_cum
                AW = AV * io_indir_r
                ak_mode = (AI_ibnr / denom_AK) if (AC <= pred_time and AD > pred_time and denom_AK != 0) else 0.0
                AX = (AU - AV) * ak_mode if (AC <= pred_time and AD > pred_time) else 0.0
                AY = AX * io_indir_r
                AZ = (AX + AY) * reins_r
                BA = AX * nra_inc
                BB = AY * nra_inc
                BC = AZ * nra_inc
                midx_claims = d + a - 2
                midx_ibnr = d - 1 + a
                df_end_claims = disc_end.get(midx_claims, 0.0)
                df_end_ibnr = disc_end.get(midx_ibnr, 0.0)
                df_begin_ibnr = disc_begin.get(midx_ibnr, 0.0)
                AM_claims = df_end_claims if AD > pred_time else 0.0
                AM_ibnr = df_end_ibnr if AD > pred_time else 0.0
                AN = df_end_ibnr if (AB is not None and AB > pred_time) else 0.0
                AO = df_begin_ibnr if (AB is not None and AB > pred_time) else 0.0
                AP = -Ueff * AE_mode
                AQ = 0.0 if 分出 else -V_eff * AF_mode
                BD = AP * AO
                BE = AQ * AO
                BF = AR * AM_claims
                BG = AS * AN
                BH = AR * nra_und * AM_claims + AS * nra_und * AN
                BI = AX * AM_ibnr
                BJ = AY * AM_ibnr
                BK = -AZ * AM_ibnr
                BL = BA * AM_ibnr
                BM = BB * AM_ibnr
                BN = -BC * AM_ibnr
                cc_val = CC if (a == 1 and d == 0) else 0.0
                rows.append(dict(a=a, d=d, AC=AC, AD=AD, AB=AB, AH=AH, AG=AG,
                                 AI=AI, CA=CA, AR=AR, CB=CB, AS=AS, AT=AT,
                                 AU=AU, AV=AV, AW=AW, AK=ak_mode, AX=AX, AY=AY,
                                 AZ=AZ, BA=BA, BB=BB, BC=BC,
                                 AN=AN, AO=AO, AP=AP, AQ=AQ,
                                 BD=BD, BE=BE, BF=BF, BG=BG, BH=BH, BI=BI, BJ=BJ,
                                 BK=BK, BL=BL, BM=BM, BN=BN, CC=cc_val))

        # ---- aggregate (PAA计算_新业务预测) ----
        def s(col):
            return sum(r[col] for r in rows)

        def siff(col, cond):
            return sum(r[col] for r in rows if cond(r))

        L = get(earn.get(预测组ID, {}), 1)   # 当期确认比例 = earn[1] (oracle: earn keyed by 合同组ID=预测组ID)
        M = L
        AK_recv = -siff("AP", lambda r: r["AB"] is not None and r["AB"] == pred_time)
        AL_paid = -siff("AQ", lambda r: r["AB"] is not None and r["AB"] == pred_time)
        BD_sum = s("BD"); BE_sum = s("BE")
        AE = -BD_sum + AK_recv * (1 + P)
        AF = -BE_sum + AL_paid * (1 + P)
        AG_inv = AE * invest_r
        AM = P * (AK_recv + AL_paid)
        AN = (AG_inv - AE) * L
        AO = -AF * M
        AP_inv = -AG_inv * L
        AQ_nonloss = AK_recv + AL_paid + AM + AN + AO + AP_inv
        CC_sum = s("CC")
        AR_future = s("BD") - CC_sum
        AS_future = s("BE")
        AT_future = s("BF")
        AU_future = s("BG")
        AV_future = s("BH")
        AW_future = AR_future + AS_future + AT_future + AU_future + AV_future
        AX_loss = max(AW_future - AQ_nonloss, 0.0)
        AY_recov = 0.0 if 分出 else -AX_loss * recov_r
        AZ_pay = -siff("AV", lambda r: r["d"] == PERIOD)
        BA_pay = -siff("AW", lambda r: r["d"] == PERIOD)
        BB_maint = -siff("AS", lambda r: r["AB"] is not None and r["AB"] == pred_time)
        BC_pay = AZ_pay
        BD_claim = BA_pay
        Y = s("BI"); Z = s("BJ"); AA_r = s("BK"); AB_r = s("BL"); AC_r = s("BM"); AD_r = s("BN")
        BS = -(Y + BC_pay)
        BT = -(AB_r)
        BU = -(Z + BD_claim)
        BV = -(AC_r)
        BY = -AM

        out = {}
        out["输出_未到期责任负债_非亏损部分"] = AQ_nonloss
        out["输出_未到期责任负债_亏损部分"] = AX_loss
        out["输出_未到期责任负债_亏损摊回"] = AY_recov
        out["输出_已发生未决赔款负债_预期现金流"] = Y
        out["输出_间接理赔费用负债_预期现金流"] = Z
        out["输出_已发生未决赔款负债_再保人不履约_预期现金流"] = AA_r
        out["输出_已发生未决赔款负债_非金融风险调整"] = AB_r
        out["输出_间接理赔费用负债_非金融风险调整"] = AC_r
        out["输出_已发生未决赔款负债_再保人不履约_非金融风险调整"] = AD_r
        out["输出_保险合同收入"] = -AN
        out["输出_赔付与费用_分解的投资成分"] = -AP_inv
        out["输出_赔付与费用_摊销的保险获取现金流"] = -AO
        out["输出_亏损合同损益"] = -(AX_loss - 0.0)
        out["输出_亏损摊回损益"] = -(AY_recov - 0.0)
        out["输出_赔付与费用_已发生未决赔款负债提转差_预期现金流"] = BS
        out["输出_赔付与费用_已发生未决赔款负债提转差_非金融风险调整"] = BT
        out["输出_赔付与费用_间接理赔费用提转差_预期现金流"] = BU
        out["输出_赔付与费用_间接理赔费用提转差_非金融风险调整"] = BV
        out["输出_赔付与费用_再保人不履约风险提转差_预期现金流"] = -AA_r
        out["输出_赔付与费用_再保人不履约风险提转差_非金融风险调整"] = -AD_r
        out["输出_IFIE_未到期_未到期计息"] = BY
        out["输出_IFIE_已发生未决_已发生未决赔款负债计息与利率变化_预期现金流"] = 0.0
        out["输出_IFIE_已发生未决_已发生未决赔款负债计息与利率变化_非金融风险调整"] = 0.0
        out["输出_IFIE_已发生未决_间接理赔费用计息与利率变化_预期现金流"] = 0.0
        out["输出_IFIE_已发生未决_间接理赔费用计息与利率变化_非金融风险调整"] = 0.0
        out["输出_现金流_支付的赔付与理赔费用"] = BC_pay + BD_claim
        out["输出_现金流_支付的维持费用"] = BB_maint
        out["输出_现金流_收到的保费"] = AK_recv
        out["输出_现金流_支付的IACF"] = AL_paid
        out["输出_OCI_已发生未决_已发生未决赔款负债计息与利率变化_预期现金流"] = -(Y + BS)
        out["输出_OCI_已发生未决_已发生未决赔款负债计息与利率变化_非金融风险调整"] = -(AB_r + BT)
        out["输出_OCI_已发生未决_间接理赔费用计息与利率变化_预期现金流"] = -(Z + BU)
        out["输出_OCI_已发生未决_间接理赔费用计息与利率变化_非金融风险调整"] = -(AC_r + BV)

        return {
            'sums': {},
            'confirm_ratio': L,
            'amortization_ratio': M,
            'investment_ratio': invest_r,
            'recov_r': recov_r,
            'ceding_recover_ratio': recov_r,
            'premium_income': U,
            'acquisition_cost': V,
            'paa': out,
        }

    def _calculate_cashflows_existing(self, group: dict, eval_date, forecast_period: int,
                                       rate_curve: dict, scenario_params: dict,
                                       watchdog=None) -> dict:
        """Faithful existing-business PAA: reconstruct the 3600-row development triangle from
        system input tables and aggregate per PAA计算_现有业务预测 formulas.
        Verified against IFRS17财务预测_改造版_0729_VBA (PAA计算_现有业务整理 输出_* columns, 0 diff)."""
        act_class = str(group.get('精算险类', ''))
        biz_type = str(group.get('直保或分入/分出', '直保或分入'))
        分出 = (biz_type == '分出')
        预测组 = str(group.get('现有业务预测组', '') or group.get('预测组', ''))
        合同组ID = str(group.get('合同组ID', '') or group.get('现有业务预测组ID', ''))
        _ew_raw = _to_int(group.get('评估期开始业务预期写入时间（月）', 0))
        # 验证文件(0729)该字段以 1 为基(首个预期写入月=1)，而 VBA/三角公式按 0 基偏移使用
        # (ap = und_incur[d+1-eval_write])，故转为 0 基偏移以与验证文件输出一致。
        eval_write = _ew_raw - 1 if _ew_raw > 0 else _ew_raw
        PERIOD = forecast_period
        pred_time = _eomonth(eval_date, PERIOD)

        def get(d, k, default=0.0):
            if d is None:
                return default
            v = d.get(k)
            if v is None:
                return default
            try:
                return float(v)
            except Exception:
                return default

        # ---- build input lookups (cached on self for the whole run) ----
        if not hasattr(self, '_fl_existing'):
            self._fl_existing = {}
        fl = self._fl_existing

        def monthly(sheet, key_header=None):
            cache_key = sheet if key_header is None else f"{sheet}#{key_header}"
            if cache_key in fl:
                return fl[cache_key]
            s = self._get_sheet(sheet)
            hdr = s['headers']
            rows = s['rows']
            key_idx = None
            # 解析 key 列: 优先用指定 key_header，否则按候选列表回退
            # （附件最新规范已把现有业务模式表的 合同组ID 改为 预测组）
            candidates = []
            if key_header is not None:
                candidates.append(key_header)
            candidates += ['预测组', '精算险类', '合同组ID']
            for cand in candidates:
                for i, h in enumerate(hdr):
                    if h == cand:
                        key_idx = i
                        break
                if key_idx is not None:
                    break
            if key_idx is None:
                key_idx = 0
            mcols = {}
            for i, h in enumerate(hdr):
                if i > key_idx and h is not None:
                    try:
                        m = _to_int(h)
                        mcols[m] = i
                    except Exception:
                        pass
            out = {}
            for r in rows:
                if key_idx >= len(r) or r[key_idx] is None:
                    continue
                k = _norm_key(r[key_idx])
                d = {}
                for m, ci in mcols.items():
                    if ci < len(r) and r[ci] is not None:
                        try:
                            d[m] = float(r[ci])
                        except Exception:
                            d[m] = 0.0
                out[k] = d
            fl[cache_key] = out
            return out

        ep = monthly('预期赔付率')
        recov = monthly('预期摊回比例_现有业务')
        invest = monthly('投资成分比例')
        # 模式表（保费/IACF/赚取）VBA 实际按 合同组ID 取数（与 oracle 一致）
        prem_mode = monthly('保费现金流模式_现有业务', key_header='预测组')
        iacf_mode = monthly('IACF现金流模式_现有业务', key_header='预测组')
        earn = monthly('未到期赚取模式_现有业务', key_header='预测组')
        maint = monthly('维持费用率')
        io_indir = monthly('未到期间接理赔费用率')
        io_incur = monthly('未决间接理赔费用率')
        reins = monthly('再保人不履约风险')
        und_incur = monthly('未到期赔付模式')
        dev = monthly('未决赔付模式')
        cum = monthly('实际赔付比例')

        if 'riskadj' not in fl:
            s = self._get_sheet('风险调整比例')
            hdr = s['headers']
            rows = s['rows']
            ra = {}
            for r in rows:
                if len(r) > 2 and r[2] is not None:
                    ra[str(r[2])] = {h: r[i] for i, h in enumerate(hdr) if h is not None}
            fl['riskadj'] = ra
        riskadj = fl['riskadj']

        if 'ea_existing' not in fl:
            s = self._get_sheet('合同组关键假设_现有业务')
            hdr = s['headers']
            rows = s['rows']
            ea = {}
            for r in rows:
                if len(r) > 2 and r[2] is not None:
                    ea[str(r[2])] = {h: r[i] for i, h in enumerate(hdr) if h is not None}
            fl['ea_existing'] = ea
        ea = fl['ea_existing']

        if 'opening' not in fl:
            s = self._get_sheet('系统期初余额表')
            hdr = s['headers']
            rows = s['rows']
            op = {}
            for r in rows:
                if len(r) > 2 and r[2] is not None:
                    k = str(r[2])
                    d = {h: r[i] for i, h in enumerate(hdr) if h is not None}
                    op[k] = d
                    if not k.endswith('&0'):
                        op[k + '&0'] = d
            fl['opening'] = op
        opening = fl['opening']

        if 'intrate' not in fl:
            s = self._get_sheet('初始确认利率曲线')
            hdr = s['headers']
            rows = s['rows']
            pidx = hdr.index('月度远期') if '月度远期' in hdr else 3
            ir = {}
            for r in rows:
                if pidx >= len(r) or r[pidx] is None:
                    continue
                try:
                    p = int(float(r[pidx]))
                except Exception:
                    continue
                for j, h in enumerate(hdr):
                    if j > pidx and h is not None and r[j] is not None:
                        try:
                            ir.setdefault(str(h), {})[p] = float(r[j])
                        except Exception:
                            pass
            fl['intrate'] = ir
        intrate = fl['intrate']

        # ---- resolve group inputs ----
        pr = get(ep.get(预测组, {}), PERIOD)
        mr = 0.0 if 分出 else get(maint.get(act_class, {}), PERIOD)
        nra_und = get(riskadj.get(act_class, {}), '未到期风险调整%')
        nra_inc = get(riskadj.get(act_class, {}), '未决风险调整%')
        reins_r = get(reins.get(act_class, {}), PERIOD) if 分出 else 0.0
        io_key = IO_RISK_REMAP.get(act_class, act_class)
        io_indir_r = 0.0 if 分出 else get(io_indir.get(io_key, {}), PERIOD)
        io_incur_r = 0.0 if 分出 else get(io_incur.get(io_key, {}), PERIOD)
        recov_r = 0.0 if 分出 else get(recov.get(预测组, {}), PERIOD)
        invest_r = get(invest.get(预测组, {}), PERIOD)
        int_rate = get(intrate.get(预测组, {}), PERIOD)

        # ---- 情景压力（按预测时点所在年取压力值）----
        # 预期赔付率上升 -> 提高预期赔付（open_* * aq 索赔现金流）；预期费用率上升 -> 提高维持费用与IACF。
        # 注：现有业务 UPR 为锁定期初余额，不施加保费增长压力（与 IFRS17 期初口径一致）。
        _yr = (PERIOD - 1) // 12 + 1
        _sp = scenario_params.get(_yr, {})
        _loss_ratio_adj = _sp.get('loss_ratio_adj', 0.0)
        _expense_ratio_adj = _sp.get('expense_ratio_adj', 0.0)
        mr_eff = mr * (1 + _expense_ratio_adj)
        ea_row = ea.get(合同组ID, {})
        应收 = get(ea_row, '应收保费')
        应付IACF = get(ea_row, '应付IACF')
        op = opening.get(预测组, {})
        UPR = get(op, 'UPR余额')
        open_X = get(op, '已发生未决赔款负债_预期现金流')
        open_Y = get(op, '间接理赔费用负债_预期现金流')
        open_Z = get(op, '已发生未决赔款负债_再保人不履约_预期现金流')
        open_AA = get(op, '已发生未决赔款负债_非金融风险调整')
        open_AB = get(op, '间接理赔费用负债_非金融风险调整')
        open_AC = get(op, '已发生未决赔款负债_再保人不履约_非金融风险调整')
        open_待摊销保险收入 = get(op, '待摊销保险收入')
        open_UPR = UPR
        open_不含利净 = get(op, '未到期责任负债_非亏损部分_不含利净口径未赚')
        open_待摊销获取现金流 = get(op, '待摊销获取现金流')
        open_待摊销投资成分 = get(op, '待摊销投资成分')
        open_亏损部分 = get(op, '未到期责任负债_亏损部分')
        open_亏损摊回 = get(op, '未到期责任负债_亏损摊回')
        open_非亏损 = get(op, '未到期责任负债_非亏损部分')
        open_现值_预期现金流 = get(op, '已发生未决赔款负债_预期现金流现值')
        open_现值_间接理赔 = get(op, '间接理赔费用负债_预期现金流现值')
        open_现值_NRA = get(op, '已发生未决赔款负债_非金融风险调整现值')
        open_现值_间接理赔NRA = get(op, '间接理赔费用负债_非金融风险调整现值')

        # ---- development triangle ----
        def ap_val(a, d):
            return get(und_incur.get(act_class, {}), d + 1 - eval_write)

        denom_by_a = {}
        for a in range(1, 61):
            tot = 0.0
            for d in range(0, 60):
                if (a + d) > 1:
                    tot += ap_val(a, d)
            denom_by_a[a] = tot

        rows = []
        for a in range(1, 61):
            for d in range(0, 60):
                if watchdog is not None:
                    watchdog.tick(f'现有业务 · 开发三角 a={a}/60 d={d}/59')
                AD = (d + 1) if a == 1 else None
                AE = d if a == 1 else None
                AJ = _eomonth(eval_date, a)
                AK = _eomonth(AJ, d)
                al = get(prem_mode.get(合同组ID, {}), AD) if AD is not None else 0.0
                am = get(iacf_mode.get(合同组ID, {}), AD) if AD is not None else 0.0
                an = get(earn.get(合同组ID, {}), AD) if AD is not None else 0.0
                ao = get(earn.get(合同组ID, {}), a)
                ap = ap_val(a, d)
                aq = get(dev.get(act_class, {}), d + 1) if AE is not None else 0.0
                denom = denom_by_a[a]
                ar = ap / denom if denom else 0.0
                as_p = PERIOD - a + 1
                as_val = get(cum.get(act_class, {}), as_p) if (AJ <= pred_time and as_p >= 1) else 0.0
                midx = d - 1 + a
                disc_t = rate_curve['discount_factor_end'].get(midx, 0.0)
                disc_i = rate_curve['discount_factor_begin'].get(midx, 0.0)
                at = 0.0 if (AK <= pred_time) else disc_t
                AI = _eomonth(eval_date, AD) if AD is not None else None
                au = 0.0 if (AI is None or AI <= pred_time) else disc_t
                av = 0.0 if (AI is None or AI <= pred_time) else disc_i
                aw = -应收 * al
                ax = -应付IACF * am * (1 + _expense_ratio_adj)
                ay = (UPR * pr * ao * ap) if (AJ > pred_time) else 0.0
                az = UPR * mr_eff * an
                ba = (ay + az) * nra_und
                bb = open_X * aq * (1 + _loss_ratio_adj)
                bc = open_Y * aq * (1 + _loss_ratio_adj)
                bd = open_Z * aq * (1 + _loss_ratio_adj)
                be = open_AA * aq * (1 + _loss_ratio_adj)
                bf = open_AB * aq * (1 + _loss_ratio_adj)
                bg = open_AC * aq * (1 + _loss_ratio_adj)
                bh = (UPR * pr * ao) if (AJ <= pred_time) else 0.0
                bi = bh * as_val
                bj = bi * io_incur_r
                bk = ((bh - bi) * ar) if ((AJ <= pred_time) and (AK > pred_time)) else 0.0
                bl = (bb + bk) if ((AJ <= pred_time) and (AK > pred_time)) else 0.0
                bm = bl * io_incur_r
                bn = (bl + bm) * reins_r
                bo = bl * nra_inc
                bp = bm * nra_inc
                bq = bn * nra_inc
                br = aw * av
                bs = ax * av
                bt = ay * at
                bu = az * au
                bv = ba * at
                bw = bl * at
                bxm = bm * at
                by = -bn * at
                bz = bo * at
                ca = bp * at
                cb = -bq * at
                cc = bb * at
                cd = bc * at
                ce = bd * at
                cf_ = be * at
                cg = bf * at
                ch = bg * at
                rows.append(dict(a=a, d=d, aw=aw, ax=ax, ay=ay, az=az, ba=ba,
                                 bb=bb, bc=bc, bd=bd, be=be, bf=bf, bg=bg,
                                 bi=bi, bj=bj, bl=bl, bm=bm, bn=bn, bo=bo, bp=bp, bq=bq,
                                 br=br, bs=bs, bt=bt, bu=bu, bv=bv, bw=bw, bx=bxm, by=by, bz=bz,
                                 ca=ca, cb=cb, cc=cc, cd=cd, ce=ce, cf=cf_, cg=cg, ch=ch,
                                 ai=AI, an=an, ad=AD))

        # ---- aggregate (PAA计算_现有业务预测) ----
        def s(col):
            return sum(r[col] for r in rows)

        def siff(col, cond):
            return sum(r[col] for r in rows if cond(r))

        _an_den = siff('an', lambda r: r['ad'] is not None)
        S = (siff('an', lambda r: r['ad'] == PERIOD) / _an_den) if _an_den else 0.0
        T_ratio = S
        AI_待摊销保险收入 = (open_待摊销保险收入 + open_UPR - open_不含利净) * (1 + int_rate)
        AJ_待摊销获取现金流 = open_待摊销获取现金流 * (1 + int_rate)
        AK_待摊销投资成分 = open_待摊销投资成分 * (1 + int_rate)
        AL_期初亏损 = open_亏损部分
        AM_期初亏损摊回 = open_亏损摊回
        AN_期初非亏损 = open_非亏损
        AO_当期收到保费 = -siff('aw', lambda r: r['ai'] is not None and r['ai'] <= pred_time)
        AP_当期支出IACF = -siff('ax', lambda r: r['ai'] is not None and r['ai'] <= pred_time)
        AQ_未到期计息 = int_rate * (AN_期初非亏损 + AO_当期收到保费 + AP_当期支出IACF)
        AT_分解投资成分 = -AK_待摊销投资成分 * S
        AR_保险收入 = -AI_待摊销保险收入 * S - AT_分解投资成分
        AS_摊销获取费用 = -AJ_待摊销获取现金流 * T_ratio
        AU_期末非亏损 = (AN_期初非亏损 + AO_当期收到保费 + AP_当期支出IACF + AQ_未到期计息
                       + AR_保险收入 + AS_摊销获取费用 + AT_分解投资成分)
        AV_预期未来保费 = s('br')
        AW_预期未来IACF = s('bs')
        AX_预期未来赔付 = s('bt')
        AY_预期未来维持 = s('bu')
        AZ_NRA = s('bv')
        BA_预期未来合计 = AV_预期未来保费 + AW_预期未来IACF + AX_预期未来赔付 + AY_预期未来维持 + AZ_NRA
        BB_亏损部分 = max(BA_预期未来合计 - AU_期末非亏损, 0.0)
        BC_亏损摊回 = -BB_亏损部分 * recov_r
        BD_支付赔付 = -siff('bi', lambda r: r['d'] == PERIOD)
        BE_支付理赔费用 = -siff('bj', lambda r: r['d'] == PERIOD)
        BF_支付维持 = -siff('az', lambda r: r['ai'] is not None and r['ai'] <= pred_time)
        BG_支付赔付 = BD_支付赔付
        BH_支付理赔费用 = BE_支付理赔费用
        self._tmp_rows = rows
        AC_期末预期现金流 = s('bw')
        AD_期末间接 = s('bx')
        AE_期末再保 = s('by')
        AF_期末NRA = s('bz')
        AG_期末间接NRA = s('ca')
        AH_期末再保NRA = s('cb')
        W_期初预期 = s('cc')
        X_期初间接 = s('cd')
        Y_期初再保 = s('ce')
        Z_期初NRA = s('cf')
        AA_期初间接NRA = s('cg')
        AB_期初再保NRA = s('ch')

        out = {}
        out['输出_未到期责任负债_非亏损部分'] = AU_期末非亏损
        out['输出_未到期责任负债_亏损部分'] = BB_亏损部分
        out['输出_未到期责任负债_亏损摊回'] = BC_亏损摊回
        out['输出_已发生未决赔款负债_预期现金流'] = AC_期末预期现金流
        out['输出_间接理赔费用负债_预期现金流'] = AD_期末间接
        out['输出_已发生未决赔款负债_再保人不履约_预期现金流'] = AE_期末再保
        out['输出_已发生未决赔款负债_非金融风险调整'] = AF_期末NRA
        out['输出_间接理赔费用负债_非金融风险调整'] = AG_期末间接NRA
        out['输出_已发生未决赔款负债_再保人不履约_非金融风险调整'] = AH_期末再保NRA
        out['输出_保险合同收入'] = -AR_保险收入
        out['输出_赔付与费用_分解的投资成分'] = -AT_分解投资成分
        out['输出_赔付与费用_摊销的保险获取现金流'] = -AS_摊销获取费用
        out['输出_亏损合同损益'] = -(BB_亏损部分 - AL_期初亏损)
        out['输出_亏损摊回损益'] = -(BC_亏损摊回 - AM_期初亏损摊回)
        out['输出_赔付与费用_已发生未决赔款负债提转差_预期现金流'] = -(AC_期末预期现金流 - W_期初预期 + BG_支付赔付)
        out['输出_赔付与费用_已发生未决赔款负债提转差_非金融风险调整'] = -(AF_期末NRA - Z_期初NRA)
        out['输出_赔付与费用_间接理赔费用提转差_预期现金流'] = -(AD_期末间接 - X_期初间接 + BH_支付理赔费用)
        out['输出_赔付与费用_间接理赔费用提转差_非金融风险调整'] = -(AG_期末间接NRA - AA_期初间接NRA)
        out['输出_赔付与费用_再保人不履约风险提转差_预期现金流'] = -AE_期末再保
        out['输出_赔付与费用_再保人不履约风险提转差_非金融风险调整'] = -AH_期末再保NRA
        out['输出_IFIE_未到期_未到期计息'] = -AQ_未到期计息
        out['输出_IFIE_已发生未决_已发生未决赔款负债计息_预期现金流'] = -open_现值_预期现金流 * int_rate
        out['输出_IFIE_已发生未决_已发生未决赔款负债计息与利率变化_非金融风险调整'] = -open_现值_NRA * int_rate
        out['输出_IFIE_已发生未决_间接理赔费用计息与利率变化_预期现金流'] = -open_现值_间接理赔 * int_rate
        out['输出_IFIE_已发生未决_间接理赔费用计息与利率变化_非金融风险调整'] = -open_现值_间接理赔NRA * int_rate
        out['输出_现金流_支付的赔付与理赔费用'] = BG_支付赔付 + BH_支付理赔费用
        out['输出_现金流_支付的维持费用'] = BF_支付维持
        out['输出_现金流_收到的保费'] = AO_当期收到保费
        out['输出_现金流_支付的IACF'] = AP_当期支出IACF
        out['输出_OCI_已发生未决_已发生未决赔款负债计息与利率变化_预期现金流'] = -(
            AC_期末预期现金流 - open_现值_预期现金流
            + out['输出_赔付与费用_已发生未决赔款负债提转差_预期现金流']
            + out['输出_IFIE_已发生未决_已发生未决赔款负债计息_预期现金流'])
        out['输出_OCI_已发生未决_已发生未决赔款负债计息与利率变化_非金融风险调整'] = -(
            AF_期末NRA - open_现值_NRA
            + out['输出_赔付与费用_已发生未决赔款负债提转差_非金融风险调整']
            + out['输出_IFIE_已发生未决_已发生未决赔款负债计息与利率变化_非金融风险调整'])
        out['输出_OCI_已发生未决_间接理赔费用计息与利率变化_预期现金流'] = -(
            AD_期末间接 - open_现值_间接理赔
            + out['输出_赔付与费用_间接理赔费用提转差_预期现金流']
            + out['输出_IFIE_已发生未决_间接理赔费用计息与利率变化_预期现金流'])
        out['输出_OCI_已发生未决_间接理赔费用计息与利率变化_非金融风险调整'] = -(
            AG_期末间接NRA - open_现值_间接理赔NRA
            + out['输出_赔付与费用_间接理赔费用提转差_非金融风险调整']
            + out['输出_IFIE_已发生未决_间接理赔费用计息与利率变化_非金融风险调整'])

        # ---- intermediate keys for downstream (display / combined summary) ----
        paa = dict(out)
        paa['待摊销保险收入'] = AI_待摊销保险收入
        paa['待摊销获取现金流'] = AJ_待摊销获取现金流
        paa['待摊销投资成分'] = AK_待摊销投资成分
        paa['期初未到期责任负债_亏损部分'] = AL_期初亏损
        paa['期初未到期责任负债_亏损摊回'] = AM_期初亏损摊回
        paa['期初未到期责任负债_非亏损部分'] = AN_期初非亏损
        paa['当期收到的保费'] = AO_当期收到保费
        paa['当期支出的保险获取现金流'] = AP_当期支出IACF
        paa['未到期责任负债计息'] = AQ_未到期计息
        paa['当期确认的保险收入'] = AR_保险收入
        paa['摊销的获取费用'] = AS_摊销获取费用
        paa['当期分解的投资成分'] = AT_分解投资成分
        paa['期末未到期责任负债_非亏损部分'] = AU_期末非亏损
        paa['预期未来保费现金流入'] = AV_预期未来保费
        paa['预期未来保险获取现金流出'] = AW_预期未来IACF
        paa['预期未来赔付现金流出（含间接理赔费用）'] = AX_预期未来赔付
        paa['预期未来维持费用现金流出'] = AY_预期未来维持
        paa['非金融风险调整'] = AZ_NRA
        paa['预期未来现金流合计'] = BA_预期未来合计
        paa['未到期责任负债_亏损部分'] = BB_亏损部分
        paa['未到期责任负债_亏损摊回'] = BC_亏损摊回
        paa['现金流_支付的赔付_累计'] = BD_支付赔付
        paa['现金流_支付的间接理赔费用_累计'] = BE_支付理赔费用
        paa['现金流_支付的维持费用'] = BF_支付维持
        paa['现金流_支付的赔付'] = BG_支付赔付
        paa['现金流_支付的理赔费用'] = BH_支付理赔费用
        paa['期末现值_未决赔款现金流_期初'] = W_期初预期
        paa['期末现值_未决间接理赔费用现金流_期初'] = X_期初间接
        paa['期末现值_未决赔款现金流_再保人不履约风险_期初'] = Y_期初再保
        paa['期末现值_未决赔款现金流_非金融风险调整_期初'] = Z_期初NRA
        paa['期末现值_未决间接理赔费用现金流_非金融风险调整_期初'] = AA_期初间接NRA
        paa['期末现值_未决赔款现金流_再保人不履约风险_非金融风险调整_期初'] = AB_期初再保NRA
        paa['期末现值_未决赔款现金流_期末'] = AC_期末预期现金流
        paa['期末现值_未决间接理赔费用现金流_期末'] = AD_期末间接
        paa['期末现值_未决赔款现金流_再保人不履约风险_期末'] = AE_期末再保
        paa['期末现值_未决赔款现金流_非金融风险调整_期末'] = AF_期末NRA
        paa['期末现值_未决间接理赔费用现金流_非金融风险调整_期末'] = AG_期末间接NRA
        paa['期末现值_未决赔款现金流_再保人不履约风险_非金融风险调整_期末'] = AH_期末再保NRA

        return {
            'sums': {},
            'confirm_ratio': S,
            'amortization_ratio': T_ratio,
            'investment_ratio': invest_r,
            'recov_r': recov_r,
            'int_rate': int_rate,
            'premium_receivable': 应收,
            'iacf_payable': 应付IACF,
            'paa': paa,
        }

