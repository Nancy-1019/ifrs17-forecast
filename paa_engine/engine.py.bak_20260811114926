    @staticmethod
    def _add_months(date_obj, months: int) -> datetime.datetime:
        """Add months to a date, handling year rollover and month-end."""
        if isinstance(date_obj, str):
            date_obj = datetime.datetime.strptime(date_obj[:10], '%Y-%m-%d')
        year = date_obj.year
        month = date_obj.month + months
        while month > 12:
            month -= 12
            year += 1
        while month < 1:
            month += 12
            year -= 1
        # Clamp day to valid month end
        import calendar
        last_day = calendar.monthrange(year, month)[1]
        day = min(date_obj.day, last_day)
        return datetime.datetime(year, month, day)

    def _generate_financial_statements(self, combined_rows: list, forecast_periods: int,
                                        eval_date=None, watchdog=None) -> dict:
        """生成结构化 MTD / YTD 财务报表（完整 CAS25 口径）。

        自 2026-08-01 起，财务报表改由引擎根据 PAA 明细 + 手工输入项独立生成，
        以支持任意预测期数（如 24 个月）的完整输出；验证模块仍通过
        data_input/fixtures/verify_targets.json 与验证文件 1:1 对齐，不受此处影响。
        """
        if eval_date is None:
            eval_date = datetime.datetime(2026, 6, 30)

        # 构造日期序列：period0=评估时点，period1..forecast_periods=逐月月末
        dates = [self._fmt_date(eval_date)]
        for p in range(1, forecast_periods + 1):
            d = _eomonth(eval_date, p)
            dates.append(self._fmt_date(d))
        num_periods = len(dates)

        # 生成 PAA_MTD 明细并构造 MTD 报表
        if watchdog is not None:
            watchdog.tick('输出财务报表 · 开始生成 MTD/YTD')
        paa_mtd = self._generate_paa_mtd(combined_rows, forecast_periods, watchdog=watchdog)
        mtd_income = self._build_mtd_income_statement(paa_mtd, num_periods)
        mtd_balance = self._build_mtd_balance_sheet(combined_rows, forecast_periods, num_periods)

        # YTD 损益表由 MTD 累计得到；资产负债表为时点值，直接复用 MTD
        ytd_income = self._build_ytd_income_statement(mtd_income, dates)
        ytd_balance = [dict(r) for r in mtd_balance]

        return {
            'dates': dates,
            'mtd': {'income_statement': mtd_income, 'balance_sheet': mtd_balance},
            'ytd': {'income_statement': ytd_income, 'balance_sheet': ytd_balance},
        }

    @staticmethod
    def _fmt_date(d) -> str:
        """Format a date/datetime to YYYY-MM-DD string."""
        if d is None:
            return ''
        if isinstance(d, str):
            return d[:10]
        return d.strftime('%Y-%m-%d')

    def _generate_paa_mtd(self, combined_rows: list, forecast_periods: int, watchdog=None) -> dict:
        """Generate PAA_MTD intermediate data: {period: {财务科目: value}}.

        Maps output columns from combined summary to 财务科目 based on business type:
        - 直保或分入: 保险合同收入→保险服务收入, 赔付与费用→保险服务费用, IFIE→承保财务损失
        - 分出: 保险合同收入→分出保费的分摊, 赔付与费用→减：摊回保险服务费用, IFIE→减：分出再保险财务收益
        - All: OCI→OCI

        Also incorporates manual input sheets 费用输入项 and 其他输入项 for items
        not produced by the PAA engine (investment income, admin fees, taxes, etc.).
        Sign convention inside paa_mtd: revenue POSITIVE, expense/loss NEGATIVE.
        """
        paa_mtd = defaultdict(lambda: defaultdict(float))

        for row in combined_rows:
            period = row.get('预测间隔', 1)
            biz_type = str(row.get('业务类型', ''))

            if biz_type == '直保或分入':
                # 保险服务收入
                for col in _PAA_DIRECT_REVENUE_COLS:
                    paa_mtd[period]['保险服务收入'] += _to_float(row.get(col, 0))
                # 保险服务费用
                for col in _PAA_DIRECT_EXPENSE_COLS:
                    paa_mtd[period]['保险服务费用'] += _to_float(row.get(col, 0))
                # 承保财务损失
                for col in _PAA_DIRECT_IFIE_COLS:
                    paa_mtd[period]['承保财务损失'] += _to_float(row.get(col, 0))
                # OCI
                for col in _PAA_DIRECT_OCI_COLS:
                    paa_mtd[period]['OCI'] += _to_float(row.get(col, 0))
            else:  # 分出
                # 减：摊回保险服务费用
                for col in _PAA_CEDING_RECOVER_COLS:
                    paa_mtd[period]['减：摊回保险服务费用'] += _to_float(row.get(col, 0))
                # 分出保费的分摊
                for col in _PAA_CEDING_ALLOC_COLS:
                    paa_mtd[period]['分出保费的分摊'] += _to_float(row.get(col, 0))
                # 减：分出再保险财务收益
                for col in _PAA_CEDING_IFIE_COLS:
                    paa_mtd[period]['减：分出再保险财务收益'] += _to_float(row.get(col, 0))
                # OCI
                for col in _PAA_CEDING_OCI_COLS:
                    paa_mtd[period]['OCI'] += _to_float(row.get(col, 0))

        # ------------------------------------------------------------------
        # Merge manual input sheets (费用输入项 / 其他输入项)
        # ------------------------------------------------------------------
        for period in range(1, forecast_periods + 1):
            if watchdog is not None:
                watchdog.tick(f'输出财务报表 · MTD 期 {period}/{forecast_periods}')
            # --- 费用输入项 (sign: increase profit positive, decrease profit negative)
            admin_fee = self._get_expense_input('业务及管理费（当月发生数）', period)
            tax_surcharge = self._get_expense_input('税金及附加（当月发生数）', period)
            commission = self._get_expense_input('手续费及佣金支出（当月发生数）', period)
            reinstatement_premium = self._get_expense_input('复效保费（当月发生数）', period)
            adj_fee = self._get_expense_input('调整手续费（当月发生数）', period)
            ceding_commission = self._get_expense_input('摊回分保费用', period)

            if admin_fee:
                paa_mtd[period]['业务及管理费'] += admin_fee
            if tax_surcharge:
                paa_mtd[period]['税金及附加'] += tax_surcharge
            if commission:
                paa_mtd[period]['手续费及佣金支出'] += commission
            if reinstatement_premium:
                paa_mtd[period]['保险服务收入'] += reinstatement_premium
            if adj_fee:
                # 调整手续费：增加利润记正，减少利润记负；暂归入其他业务收入/其他业务成本
                if adj_fee > 0:
                    paa_mtd[period]['其他业务收入'] += adj_fee
                else:
                    paa_mtd[period]['其他业务成本'] += adj_fee
            if ceding_commission:
                # 摊回分保费用增加利润，作为摊回保险服务费用
                paa_mtd[period]['减：摊回保险服务费用'] += ceding_commission

            # --- 其他输入项 (values are direct amounts; losses/expenses stored negative)
            investment_income = self._get_other_input('投资收益', period)
            interest_income = self._get_other_input('利息收入', period)
            other_business_income = self._get_other_input('其他业务收入', period)
            non_operating_income = self._get_other_input('营业外收入', period)

            premium_reserve = self._get_other_input('提取保费准备金', period)
            credit_impairment = self._get_other_input('信用减值损失', period)
            other_asset_impairment = self._get_other_input('其他资产减值损失', period)
            other_business_cost = self._get_other_input('其他业务成本', period)
            non_operating_expense = self._get_other_input('营业外支出', period)
            interest_support = self._get_other_input('利息支持', period)

            if investment_income:
                paa_mtd[period]['投资收益'] += investment_income
            if interest_income:
                paa_mtd[period]['利息收入'] += interest_income
            if other_business_income:
                paa_mtd[period]['其他业务收入'] += other_business_income
            if non_operating_income:
                paa_mtd[period]['营业外收入'] += non_operating_income

            # 提取保费准备金/减值损失/其他业务成本/营业外支出/利息支持 在输入表中以正数表示支出/损失金额，
            # 为保持 paa_mtd 内支出为负的约定，取负数加入。
            if premium_reserve:
                paa_mtd[period]['提取保费准备金'] += -premium_reserve
            if credit_impairment:
                paa_mtd[period]['信用减值损失'] += -credit_impairment
            if other_asset_impairment:
                paa_mtd[period]['其他资产减值损失'] += -other_asset_impairment
            if other_business_cost:
                paa_mtd[period]['其他业务成本'] += -other_business_cost
            if non_operating_expense:
                paa_mtd[period]['营业外支出'] += -non_operating_expense
            if interest_support:
                paa_mtd[period]['利息支出'] += -interest_support

        return dict(paa_mtd)

    def _load_actual_financial_data(self) -> dict:
        """加载系统对接的"财务报表实际数"工作表，转换为 {科目: 期末余额}。

        工作表结构: 评估时点, 科目, 期末余额
        只取评估时点等于当前 eval_date 的行。
        """
        sheet = self._get_sheet('财务报表实际数', source='dock')
        if not sheet or not sheet.get('rows'):
            return {}
        headers = sheet.get('headers', [])
        rows = sheet['rows']

        # 找列索引
        idx_eval = -1
        idx_item = -1
        idx_val = -1
        for i, h in enumerate(headers):
            hn = str(h or '').strip()
            if hn == '评估时点':
                idx_eval = i
            elif hn == '科目':
                idx_item = i
            elif hn == '期末余额':
                idx_val = i
        if idx_item < 0 or idx_val < 0:
            return {}

        result = {}
        for row in rows:
            if not row:
                continue
            item_name = str(row[idx_item] or '').strip() if idx_item < len(row) else ''
            val = _to_float(row[idx_val]) if idx_val < len(row) else 0.0
            if item_name:
                # 同一科目有多行时累加
                result[item_name] = result.get(item_name, 0.0) + val
        return result

    def _build_mtd_income_statement(self, paa_mtd: dict, num_periods: int) -> list:
        """Build MTD income statement rows from PAA_MTD data.

        Period 0 (= 评估时点) 的值取自"财务报表实际数"工作表（系统对接数据）。
        """
        rows = []

        # 加载评估时点的实际数据
        actual_data = self._load_actual_financial_data()

        # 按核心关键词匹配（不依赖特殊字符变体 — / — 等）
        def get_actual_for(label: str) -> float:
            if label in actual_data:
                return actual_data[label]
            # 去掉前后缀（中文破折号—vs英文-，净亏损以"—"填列 vs 净亏损以"-"号填列 等变体）
            label_norm = label.replace('"-"', '""').replace('"—"', '""')
            for k, v in actual_data.items():
                if k == label_norm:
                    return v
            # 关键词归一化：移除括号内的损失以"..."号填列字样
            import re as _re
            label_core = _re.sub(r'[（(].*?[)）]', '', label).strip()
            for k, v in actual_data.items():
                k_core = _re.sub(r'[（(].*?[)）]', '', k).strip()
                if k_core == label_core:
                    return v
            # 包含关系：实际数行被归并到短名
            if label_core in ('承保利润', '一、营业总收入', '三、营业利润', '四、利润总额', '五、净利润', '六、其他综合收益', '七、综合收益总额'):
                for k, v in actual_data.items():
                    k_core2 = _re.sub(r'[（(].*?[)）]', '', k).strip()
                    if k_core2.startswith(label_core[:3]):
                        return v
            return 0.0

        for label, indent, is_total, ftype in INCOME_STATEMENT_ITEMS:
            row = {'item': label, 'indent': indent, 'is_total': is_total, 'values': []}

            for p in range(num_periods):
                if p == 0:
                    # Period 0 = eval date: 取自财务报表实际数
                    row['values'].append(get_actual_for(label))
                    continue

                mtd = paa_mtd.get(p, {})
                val = 0.0

                if ftype == 'paa_revenue':
                    # Revenue is positive in PAA_MTD → positive in report
                    val = mtd.get('保险服务收入', 0)
                elif ftype == 'paa_service_expense':
                    # PAA_MTD expense is negative → negate to positive in report
                    val = -mtd.get('保险服务费用', 0)
                elif ftype == 'paa_ceding_expense':
                    # PAA_MTD ceding alloc is negative → negate to positive in report
                    val = -mtd.get('分出保费的分摊', 0)
                elif ftype == 'paa_recover':
                    # 减：摊回 is positive in PAA_MTD → positive in report
                    val = mtd.get('减：摊回保险服务费用', 0)
                elif ftype == 'paa_financial_loss':
                    # PAA_MTD IFIE is negative → negate to positive in report
                    val = -mtd.get('承保财务损失', 0)
                elif ftype == 'paa_reins_financial':
                    # 减：分出再保险财务收益 is positive in PAA_MTD → positive in report
                    val = mtd.get('减：分出再保险财务收益', 0)
                elif ftype == 'oci':
                    val = mtd.get('OCI', 0)
                elif ftype == 'paa_admin_expense':
                    # PAA_MTD admin expense is negative → negate to positive in report
                    val = -mtd.get('业务及管理费', 0)
                elif ftype == 'paa_tax':
                    # PAA_MTD tax is negative → negate to positive in report
                    val = -mtd.get('税金及附加', 0)
                elif ftype == 'interest_income':
                    val = mtd.get('利息收入', 0)
                elif ftype == 'investment_income':
                    val = mtd.get('投资收益', 0)
                elif ftype == 'other_income':
                    val = mtd.get('其他收益', 0)
                elif ftype == 'fair_value_income':
                    val = mtd.get('公允价值变动收益', 0)
                elif ftype == 'fx_income':
                    val = mtd.get('汇兑收益', 0)
                elif ftype == 'other_business_income':
                    val = mtd.get('其他业务收入', 0)
                elif ftype == 'asset_disposal_income':
                    val = mtd.get('资产处置收益', 0)
                elif ftype == 'premium_reserve':
                    # PAA_MTD reserve change is negative (expense) → positive in report
                    val = -mtd.get('提取保费准备金', 0)
                elif ftype == 'interest_expense':
                    # PAA_MTD interest expense is negative → positive in report
                    val = -mtd.get('利息支出', 0)
                elif ftype == 'commission_expense':
                    # PAA_MTD commission expense is negative → positive in report
                    val = -mtd.get('手续费及佣金支出', 0)
                elif ftype == 'credit_impairment':
                    val = -mtd.get('信用减值损失', 0)
                elif ftype == 'other_asset_impairment':
                    val = -mtd.get('其他资产减值损失', 0)
                elif ftype == 'other_business_cost':
                    val = -mtd.get('其他业务成本', 0)
                elif ftype == 'non_operating_income':
                    val = mtd.get('营业外收入', 0)
                elif ftype == 'non_operating_expense':
                    # PAA_MTD non-operating expense is negative → positive in report
                    val = -mtd.get('营业外支出', 0)
                elif ftype == 'sum_revenue':
                    # Will be calculated after all items are built
                    pass
                elif ftype == 'sum_expense':
                    pass
                elif ftype == 'operating_profit':
                    pass
                elif ftype == 'total_profit':
                    pass
                elif ftype == 'income_tax':
                    pass
                elif ftype == 'net_profit':
                    pass
                elif ftype == 'comprehensive_income':
                    pass
                elif ftype == 'underwriting_profit':
                    pass
                # 'zero' and others → 0

                row['values'].append(round(val, 2))

            rows.append(row)

        # Post-process: calculate totals and derived items
