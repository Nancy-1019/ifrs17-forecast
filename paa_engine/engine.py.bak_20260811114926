def _to_int(v) -> int:
    """Safely convert value to int."""
    if v is None or v == '':
        return 0
    try:
        return int(float(v))
    except (ValueError, TypeError):
        return 0


def _add_months(dt: datetime.datetime, months: int) -> datetime.datetime:
    """Add months to a datetime (end of month)."""
    if dt is None:
        return None
    y = dt.year + (dt.month + months - 1) // 12
    m = (dt.month + months - 1) % 12 + 1
    # End of month
    if m == 12:
        last_day = 31
    else:
        next_month = datetime.datetime(y if m < 12 else y + 1, m + 1 if m < 12 else 1, 1)
        last_day = (next_month - datetime.timedelta(days=1)).day
    return datetime.datetime(y, m, last_day)


def _eomonth(dt: datetime.datetime, months: int) -> datetime.datetime:
    """Excel EOMONTH function: end of month after adding months."""
    return _add_months(dt, months)


def _build_lookup(rows: list, headers: list, key_col: int) -> dict:
    """Build a lookup dict from rows: {key_value: row_dict}."""
    result = {}
    for row in rows:
        if key_col < len(row) and row[key_col] is not None:
            key = row[key_col]
            if key not in result:
                result[key] = {h: row[i] if i < len(row) else None for i, h in enumerate(headers)}
    return result


def _vlookup(lookup_dict: dict, key, col_name: str, default=0):
    """VLOOKUP equivalent: find row by key, return column value."""
    if key in lookup_dict:
        v = lookup_dict[key].get(col_name)
        return v if v is not None else default
    return default


def _match_month(headers: list, month: int) -> int:
    """MATCH equivalent: find column index for a month number in headers."""
    for i, h in enumerate(headers):
        if h is not None:
            try:
                if int(float(h)) == month:
                    return i
            except (ValueError, TypeError):
                pass
    return -1


